{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@acme/schemas": ["./packages/schemas/src/reservation.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"]
}
