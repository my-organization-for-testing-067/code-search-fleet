#!/usr/bin/env bash
# cs -- one code-search interface over several engines.
#
# Why a facade: measured across nine fixture queries (fixtures/BASELINE.md), no
# single engine won more than two, and each failed where another succeeded.
# ripgrep cannot see a route assembled from two C# attributes; a symbol graph
# cannot see a string literal in argument position; only an LSP resolves an
# interface to its implementation. Picking one engine means accepting its blind
# spot permanently.
#
# Subcommands are shaped like QUESTIONS, not like tools, so the caller does not
# need to know which engine answers what -- and so the routing can change
# without every caller changing. Output is normalized to
#
#     repo/path:line: text
#
# which keeps results compact (raw tokensave JSON measured ~7x the equivalent
# ripgrep output) and lets any answer be scored by scripts/score-seams.
#
# Every answer is labelled with HOW it was obtained -- resolved, structural,
# textual, declared, or heuristic -- because on a real codebase the difference
# decides whether you can act on it. A resolved reference is a fact; a textual
# match is an occurrence; and no static answer here can see reflection, string
# concatenation, or generated code. `cs why <kind>` spells out the blind spots.
#
# Usage:
#   cs text   <pattern>            literal or regex, every repo
#   cs seam   <string>             cross-repo seam: which repos share this string
#   cs uses   <string>             like seam, but code only -- comments excluded
#   cs def    <symbol> [repo]      where a symbol is defined (optionally one repo)
#   cs provides <coordinate>       which repo publishes a package coordinate
#   cs deps   [repo]               fleet dependency edges, from build manifests
#   cs versions [coordinate]       which version each repo pins, and where they disagree
#   cs owns   [repo|repo/path]     who CODEOWNERS names for this, across the fleet
#   cs publishes                   what each repo publishes
#   cs calls  <pattern> [lang]     structural: call shapes, literal arguments
#   cs impls  <symbol> <repo>      implementations of an interface (LSP)
#   cs refs   <symbol> <repo> <file>   references to a symbol (LSP)
#   cs history <string> [repo]     when a seam entered or left history (git -S)
#   cs repos                       what is in the current view, and from where
#   cs which                       decision table: which subcommand answers what
#   cs why    [kind]               what each kind of answer cannot see
#   cs engines                     which engines are available here
#
#   --fleet          ignore the ticket workspace, search the fleet only
#   --ticket=<id>    search a named ticket workspace layered over the fleet
#   --why            print the blind spots of this answer's kind
#   --quiet          suppress the provenance line (stdout is unaffected either way)
#   --all            no result cap for this query
#   --engine=<name>  force one engine and fail rather than fall back
#                    (--engine=tokensave makes cs def read a per-repo graph
#                    instead of the fleet-wide ctags index)
#   --refresh        rebuild the cached symbol index instead of reusing it
#   --porcelain      one JSON object on stdout instead of result lines
#                    (CS_JSON=1 does the same; stderr is unaffected)
#   --word, -w       match whole identifiers only, not substrings of longer
#                    ones. Off by default: it would drop `reserve` inside
#                    `reserveItem`, a real use. cs reports the distinction
#                    either way, and cs seam's orphan warning always uses it.
#
# Environment:
#   CS_MAX_RESULTS   result cap, default 200 (0 = unlimited)
#   CS_TIMEOUT       per-engine timeout in seconds, default 120 (0 = none)
#   CS_TAGS_TTL      how long `cs def` reuses its symbol index, default 60s
#   CS_EXCLUDE_EXTRA directories to skip, in addition to the built-in list
#   CS_EXCLUDE_REMOVE directories to STOP skipping, e.g. "bin vendor" when a
#                    repo keeps hand-written source there (`cs engines` prints
#                    the effective list)
#
# Exit codes:
#   0  the query ran and found at least one hit
#   1  REFUSAL -- the query did not run (no fleet root, a missing required
#      dependency, an unknown workspace, unparseable arguments). Nothing was
#      searched, so nothing was ruled out.
#   2  the query ran honestly and found nothing.
#
# 1 and 2 are opposite facts and used to be the same number, which left the
# distinction available only as prose on stderr -- so `if cs uses "$x"; then …`
# reported "unused" for a typo'd FLEET_ROOT, the exact false negative the whole
# design is organised against. Branch on the code, not on the message.
#
# A BROKEN engine refuses too, and that is the point of the distinction: an
# engine that is installed and failing (ripgrep exiting 2, an uncompilable
# regex, a crashing deps.py) produces no output, which is indistinguishable
# from an honest zero until its exit status is read. Every engine's status is
# checked, so 2 means the search actually ran.
#
# --porcelain / CS_JSON=1 puts the same facts on stdout as one JSON object:
#   {"cs":1,"subcommand":…,"exit":…,"refused":…,"reason":…,"kind":…,"engine":…,
#    "note":…,"hits":…,"repos":…,"degraded":…,"partial":…,"truncated":…,
#    "returned":…,"engine_errors":[…],"hints":[…],"results":[…]}
# `hits` is how many exist and `returned` how many are in `results`; comparing
# them is how a caller sees a cap without reading a stderr warning.
#
# Requires: python3 (uses, provides, deps, publishes, versions, owns, impls,
# refs). Everything else is optional -- `cs engines` reports what is present,
# and cs routes around what is not.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"
root="${FLEET_ROOT:-$PWD}"

# ---- exit codes ------------------------------------------------------------
# Three outcomes, three codes. A refusal ("this search did not happen") and a
# zero-hit answer ("this search happened and the answer is no") are opposite
# facts, and both used to exit 1 -- so the tool's central promise existed only
# as prose on stderr, which a script discards and an agent skips under context
# pressure. `die()` in common.sh already exits REFUSED; the zero-hit sites
# return NO_HITS.
#
# 1 stays the refusal so that anything already checking "did this fail" keeps
# working; 2 is the newly distinguishable case.
CS_EXIT_REFUSED=1
CS_EXIT_NO_HITS=2

# ---- machine-readable output -----------------------------------------------
# The exit code above split "did not run" from "ran and found nothing", but
# everything else a caller needs to weigh an answer was still prose on stderr:
# the answer KIND, and the four warnings the skill instructs an agent to pass on
# rather than swallow (PARTIAL, `showing N of M`, `degraded:`, `prose filtered
# except:`). All are load-bearing and all are easy to discard.
#
# --porcelain (or CS_JSON=1) puts one JSON object on stdout instead of the
# result lines, carrying the metadata alongside the hits -- including on a
# refusal, which is the case a caller most needs to detect and the one with no
# result stream to attach anything to.
#
# stderr is untouched: the human diagnostics stay exactly where they were, so
# --porcelain composes with --quiet rather than replacing it.
porcelain=0
CS_RESULTS=""      # what would have gone to stdout
CS_HINTS=""        # the "nothing found — try:" suggestions
CS_REFUSAL=""      # the message from die(), if we refused
CS_HITS=""; CS_REPOS=""; CS_SUB=""; CS_QUERY=""

# JSON string escaping, in bash rather than through python3, so that porcelain
# works everywhere cs does -- `cs text` and `cs seam` run without python3, and a
# refusal for a MISSING python3 obviously cannot format itself with it.
# Raw UTF-8 is legal inside a JSON string, so only the structural characters and
# the control characters that can actually occur here are escaped.
json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\n'/\\n}"
  printf '"%s"' "$s"
}
# A number, or `null` when the value is unknown -- never an empty string, which
# would make `hits` unreadable without a type check on the far side.
json_num() { case "${1:-}" in ''|*[!0-9]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }

# Result lines are `repo/path:line: text` for every search subcommand, so they
# are split into fields rather than handed over as strings a caller would have
# to re-parse with the regex this tool already applied. A line that does not
# match that shape (cs deps, cs versions, cs owns, cs history) is carried whole
# under "text", which keeps one array type across every subcommand.
json_results() {
  local first=1 line repo path lineno text
  printf '['
  # `|| [[ -n "$line" ]]`: read returns non-zero on a final line with no
  # trailing newline, and dropping it silently cost exactly one hit per query.
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    first=0
    if [[ "$line" =~ ^([^/]+)/(.+):([0-9]+):\ ?(.*)$ ]]; then
      repo="${BASH_REMATCH[1]}"; path="${BASH_REMATCH[2]}"
      lineno="${BASH_REMATCH[3]}"; text="${BASH_REMATCH[4]}"
      printf '{"repo":%s,"path":%s,"line":%s,"text":%s}' \
        "$(json_str "$repo")" "$(json_str "$path")" "$lineno" "$(json_str "$text")"
    else
      printf '{"repo":null,"path":null,"line":null,"text":%s}' "$(json_str "$line")"
    fi
  done
  printf ']'
}

json_lines() {  # a plain array of strings, for hints and engine errors
  local first=1 line
  printf '['
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '%s' "$(json_str "$line")"
  done
  printf ']'
}

# Refuse to answer rather than answer "nothing found" from an empty or missing
# fleet. A negative result is the answer that makes a breaking change look safe,
# so it is the one that must never be manufactured by a configuration mistake.
# Before this guard, a fleet root that did not exist produced a `cd` error on
# stderr and then a perfectly formatted "no code uses X · 0 hit(s) · 0 repo(s)".
#
# Applied per-subcommand rather than at load, because the guard used to fire for
# `cs which`, `cs why` and `cs engines` too -- so the three commands that exist
# to explain the tool and diagnose the setup were unavailable to exactly the
# person whose setup was not finished. `cs engines` refusing to run until the
# fleet is configured is backwards: reporting the root is half its job.
require_fleet() {
  if [[ ! -d "$root" ]]; then
    die "fleet root does not exist: $root
  set FLEET_ROOT, or run: fleet-init --config --fleet-root <dir> --tickets-root <dir>
  (cs which, cs why and cs engines work without one)"
  fi
  if ! compgen -G "$root/*/.git" >/dev/null; then
    die "no repositories in the fleet root: $root
  clone some first: fleet-init --clone <owner/repo> ...
  (searching an empty fleet would report 'nothing found' for every query)"
  fi
}

# python3 is NOT an optional engine. The engines below degrade to each other and
# `cs engines` reports which are missing; python3 is different, because half the
# subcommands pipe THROUGH it -- `uses` through filter_code.py, the manifest
# readers through deps.py, `owns` through owners.py, the LSP pair through
# serena_call.py. Without it the pipe fails and the
# stage produces nothing, which every one of those subcommands then reports as
# a perfectly formatted zero-hit answer, still labelled "prose filtered". That
# is the same manufactured negative the fleet-root guards above exist to
# prevent, arriving by a different route, so it is checked the same way: at the
# top, once, by dying rather than answering.
have_python3() { python3 -c 'import sys' >/dev/null 2>&1; }
require_python3() {  # require_python3 <subcommand> <what it is needed for>
  have_python3 && return 0
  local why
  if command -v python3 >/dev/null 2>&1; then
    why="python3 is on PATH but failed to run"
  else
    why="python3 is not on PATH"
  fi
  die "cs $1 needs python3, and $why
  it is needed for: $2
  without it this command would report zero hits rather than fail, and a
  manufactured negative is the one answer that must never be produced
  alternative: cs seam '<string>' answers without python3, but counts comments too"
}

# ---- layered view ----------------------------------------------------------
# Work happens in a ticket workspace holding only the repos being changed, but
# the questions that matter are fleet-wide: "who calls this endpoint" must see
# the eight repos NOT in the ticket, or renaming a route looks safe when it is
# not. Searching only the ticket misses callers; searching only the fleet shows
# stale copies of what you are editing. Both answers are wrong.
#
# So a view is assembled: a directory of symlinks where ticket repos point at
# the workspace (your branch state) and every other repo points at the fleet
# (main). One root, correct contents. Engines need explicit flags to follow
# symlinks, which is why each is passed one below.
view="$root"
view_tmp=""
ticket_root="${TICKET_ROOT:-}"
# The raw --ticket=<id>, kept unresolved until build_view so that a bad one can
# be reported as "no such workspace" rather than quietly becoming a fleet search.
ticket_id=""
layer_note=""

# common.sh's die() is the single refusal path, and porcelain needs the reason
# it carried -- a refusal is the outcome a caller most needs to detect, and the
# one with no result stream to attach anything to. Redefined rather than edited
# in common.sh, because the other fleet scripts have no envelope to fill in.
# stderr keeps the human message either way.
die() { CS_REFUSAL="$*"; err "$*"; exit "$CS_EXIT_REFUSED"; }

# One JSON object on stdout, emitted from the EXIT trap so that it is produced
# on every path -- including die(), which does not come back. Verified that a
# command-substitution subshell does not run this trap, so the envelope cannot
# leak into a captured value.
cs_emit_porcelain() {
  local rc="$1"
  [[ $porcelain -eq 1 ]] || return 0
  local refused=false
  [[ "$rc" -eq "$CS_EXIT_REFUSED" ]] && refused=true
  # PARTIAL covers both ways a result can be a subset of the truth: an engine
  # that ran out of time, and files it could not read.
  local partial=false
  { timed_out || files_skipped; } && partial=true
  printf '{'
  printf '"cs":1,'
  printf '"subcommand":%s,' "$(json_str "$CS_SUB")"
  printf '"query":%s,'      "$(json_str "$CS_QUERY")"
  printf '"exit":%s,'       "$rc"
  printf '"refused":%s,'    "$refused"
  if [[ -n "$CS_REFUSAL" ]]; then
    printf '"reason":%s,' "$(json_str "$CS_REFUSAL")"
  else
    printf '"reason":null,'
  fi
  if [[ -n "$CS_KIND" ]]; then
    printf '"kind":%s,'   "$(json_str "$CS_KIND")"
    printf '"engine":%s,' "$(json_str "$CS_ENGINE")"
  else
    printf '"kind":null,"engine":null,'
  fi
  if [[ -n "$CS_NOTE" ]]; then printf '"note":%s,' "$(json_str "$CS_NOTE")"
  else printf '"note":null,'; fi
  printf '"hits":%s,'  "$(json_num "$CS_HITS")"
  printf '"repos":%s,' "$(json_num "$CS_REPOS")"
  if [[ -n "$CS_DEGRADED" ]]; then printf '"degraded":%s,' "$(json_str "$CS_DEGRADED")"
  else printf '"degraded":null,'; fi
  printf '"partial":%s,' "$partial"
  # "hits" is how many exist; "returned" is how many are in the array below.
  # A caller comparing the two learns whether it is holding the whole answer --
  # which is the question the `showing N of M` warning answers for a human.
  if [[ -n "$CS_TRUNCATED" ]]; then printf '"truncated":true,'
  else printf '"truncated":false,'; fi
  printf '"returned":%s,' "$(printf '%s' "$CS_RESULTS" | grep -c '[^[:space:]]')"
  printf '"engine_errors":%s,' "$(engine_error_lines | json_lines)"
  printf '"skipped":%s,'       "$(skipped_paths | json_lines)"
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then
    printf '"exclusions":%s,' "$(json_str "$CS_EXCLUSION_NOTE")"
  else
    printf '"exclusions":null,'
  fi
  printf '"hints":%s,'         "$(printf '%s' "$CS_HINTS"   | json_lines)"
  printf '"results":%s'        "$(printf '%s' "$CS_RESULTS" | json_results)"
  printf '}\n'
}

cleanup_view() {
  [[ -n "$view_tmp" && -d "$view_tmp" ]] && rm -rf "$view_tmp"
  [[ -n "${CS_TIMEOUT_FLAG:-}" ]] && rm -f "$CS_TIMEOUT_FLAG"
  # A half-built symbol index, if ctags was interrupted. Named per-process, so
  # this only ever removes our own.
  rm -f "${TMPDIR:-/tmp}"/cs-tags-*."$$".building 2>/dev/null
  # Same reasoning for the language server's raw response and its diagnostics:
  # the paths that refuse on a malformed answer exit through die(), which does
  # not come back to a rm.
  rm -f "${TMPDIR:-/tmp}"/cs-serena."$$".* "${TMPDIR:-/tmp}"/cs-serena-err."$$".* 2>/dev/null
  [[ -n "${CS_ENGINE_ERR_FLAG:-}" ]] && rm -f "$CS_ENGINE_ERR_FLAG"
  [[ -n "${CS_SKIPPED_FLAG:-}" ]] && rm -f "$CS_SKIPPED_FLAG"
  rm -f "${TMPDIR:-/tmp}"/cs-engerr."$$".* "${TMPDIR:-/tmp}"/cs-uses."$$".* 2>/dev/null
  rm -f "${TMPDIR:-/tmp}"/cs-tags-nokey."$$".tags 2>/dev/null
  return 0
}
# $? is captured first: the porcelain envelope reports the real exit status, and
# anything run before reading it would overwrite it.
cs_on_exit() {
  local rc=$?
  cs_emit_porcelain "$rc"
  cleanup_view
  return 0
}
# INT and TERM as well as EXIT: bash does not run an EXIT trap for an
# uncaught signal, and being ^C'd mid-index is the likeliest way to leak one.
trap cs_on_exit EXIT INT TERM

detect_ticket() {
  [[ -n "$ticket_root" ]] && return 0
  [[ -n "${TICKETS_ROOT:-}" ]] || return 1
  # Running from inside a ticket workspace implies working on that ticket.
  case "$PWD/" in
    "$TICKETS_ROOT"/*)
      local rel="${PWD#"$TICKETS_ROOT"/}"
      ticket_root="$TICKETS_ROOT/${rel%%/*}"
      [[ -d "$ticket_root" ]] || ticket_root=""
      ;;
  esac
  [[ -n "$ticket_root" ]]
}

# Resolve an explicit --ticket=<id>. Asking for a ticket by name and being given
# the fleet instead is the inverse of the mistake this whole layering exists to
# prevent: the caller wanted THEIR branch state and silently got main, with no
# `searching:` line to reveal it. A typo'd id, or one passed with TICKETS_ROOT
# unset, used to do exactly that. So an explicit request that cannot be honoured
# is fatal, while auto-detection from $PWD stays best-effort.
resolve_explicit_ticket() {
  [[ -n "$ticket_id" ]] || return 0
  # common.sh always leaves TICKETS_ROOT with a default, so the failure a caller
  # actually hits is "looked there, found nothing" rather than "not configured".
  # Naming the root is what separates a typo'd id from a wrong TICKETS_ROOT --
  # both otherwise present as an unexplained missing workspace.
  local troot="${TICKETS_ROOT:-}"
  [[ -n "$troot" ]] || die \
"--ticket=$ticket_id was requested but TICKETS_ROOT is not set
  there is nowhere to look for the workspace, and searching the fleet instead
  would answer from main while you asked for your branch
  set TICKETS_ROOT, or run: fleet-init --config --fleet-root <dir> --tickets-root <dir>"
  ticket_root="$troot/$ticket_id"
  [[ -d "$ticket_root" ]] || die \
"--ticket=$ticket_id was requested but no such workspace: $ticket_root
  searching the fleet instead would answer from main while you asked for your branch
  TICKETS_ROOT is $troot; workspaces there: $(ls -1 "$troot" 2>/dev/null | tr '\n' ' ' || echo '(none — is TICKETS_ROOT right?)')
  use --fleet if you meant to search the fleet only"
}

build_view() {
  [[ $fleet_only -eq 1 ]] && { layer_note="fleet only"; return; }
  resolve_explicit_ticket
  detect_ticket || return 0
  [[ -d "$ticket_root" ]] || return 0

  view_tmp=$(mktemp -d)
  view="$view_tmp"
  local n_ticket=0 n_fleet=0 d name
  for d in "$ticket_root"/*/; do
    [[ -d "$d" ]] || continue
    is_repo "${d%/}" || continue
    name=$(basename "$d")
    ln -s "${d%/}" "$view/$name" && n_ticket=$((n_ticket + 1))
  done
  # A workspace holding no repos layers nothing, so every answer comes from the
  # fleet. That is a legitimate state (a workspace just created, or torn down
  # mid-flight) but it is not what the caller asked for, so it is said out loud.
  if [[ $n_ticket -eq 0 ]]; then
    warn "ticket workspace $(basename "$ticket_root") holds no repos — answering from the fleet (main) only"
  fi
  for d in "$root"/*/; do
    [[ -d "$d" ]] || continue
    is_repo "${d%/}" || continue
    name=$(basename "$d")
    [[ -e "$view/$name" ]] && continue
    ln -s "${d%/}" "$view/$name" && n_fleet=$((n_fleet + 1))
  done
  layer_note="$(basename "$ticket_root") ($n_ticket repo(s), your branch) + fleet ($n_fleet repo(s), main)"
}

announce_view() {
  [[ -n "$layer_note" ]] && info "${C_BOLD}searching:${C_OFF} $layer_note"
}

# Real repo directories, for engines that cannot follow symlinks.
real_dirs() {
  local d name
  if [[ -n "$view_tmp" ]]; then
    for d in "$view"/*; do [[ -e "$d" ]] && readlink "$d"; done
  else
    for d in "$root"/*/; do [[ -d "$d" ]] && is_repo "${d%/}" && echo "${d%/}"; done
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# Evidence that an entry IS a repository, rather than merely that it exists.
#
# A fleet root grows housekeeping -- a README, an update-all.sh, an update.log,
# a folder of scratch notes -- and every enumeration site here used a different
# filter. `cs repos` used a bare glob and listed all of it, reporting 40 repos
# on a fleet of 37. That count is load-bearing: it is the denominator for
# `cs seam`'s orphan warning, and it is what the `searching:` line reports --
# the one instrument the skill explicitly tells an agent to read before trusting
# a layered answer.
#
# -e rather than -d: a git worktree's .git is a FILE holding a gitdir pointer,
# so a -d test would silently exclude every worktree, which is precisely the
# ticket-workspace layout this whole tool is built around. A plain directory of
# scratch files passes a -d test too; only the .git check rejects it.
is_repo() { [[ -e "$1/.git" ]]; }

# Entries in the fleet root that are not repositories, named rather than
# silently dropped -- the same reasoning as the `skipping:` line in cs engines.
# Every one is a place results cannot come from.
non_repo_entries() {
  local d
  for d in "$root"/*; do
    [[ -e "$d" ]] || continue
    is_repo "$d" && continue
    basename "$d"
  done
}

# Modification time in epoch seconds, or 0 if it cannot be determined.
#
# GNU and BSD `stat` share a name and almost nothing else. `-f` is "use this
# format" on BSD and "report on the FILESYSTEM" on GNU -- so `stat -f %m file`
# on Linux treats `%m` as a filename, fails with status 1, and *still writes a
# multi-line filesystem dump to STDOUT*. The obvious `stat -f %m || stat -c %Y`
# chain therefore captured both the dump and the epoch, and substituting that
# into $(( )) killed the command with "File: unbound variable".
#
# The consequence was not a crash anyone would notice, which is why it survived:
# only the CACHE-HIT path reads the mtime, so on Linux `cs def` worked the first
# time and then failed for the next 60 seconds. Hence: try each dialect, and
# accept the answer only if it is actually a number.
file_mtime() {
  local t
  for t in "$(stat -c %Y "$1" 2>/dev/null)" "$(stat -f %m "$1" 2>/dev/null)"; do
    case "$t" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$t"; return 0 ;;
    esac
  done
  printf '0\n'
}

# ---- what gets searched ----------------------------------------------------
# One exclusion list, shared by every text backend. This exists so that the
# answer does not depend on which engine happens to be installed: ripgrep and
# POSIX grep must see the SAME set of files, or a machine without ripgrep gets
# quietly different results from one with it. `verify-search` asserts that
# parity by running the scored queries through both backends and diffing.
#
# Two consequences worth stating, because both were parity bugs:
#   - ripgrep is run with --no-ignore. Respecting .gitignore would make results
#     depend on each repo's ignore file, which grep cannot read. Deterministic
#     beats clever; the list below covers the build output .gitignore would have
#     hidden anyway, and CS_EXCLUDE_EXTRA adds to it per site.
#   - ripgrep is run with --hidden. Without it, rg skips dotted paths, so
#     .github/, .circleci/ and .env are invisible to it and visible to grep.
#     Config keys and CI wiring live in exactly those files, and a config key
#     that a service reads but a chart no longer writes is a seam worth finding.
#
# The list is a guess about other people's repos, and some entries are wrong for
# some of them: `bin` and `build` are generated in most layouts and hand-written
# source in others, and a Go fleet keeps real dependencies in `vendor`. An
# excluded directory produces a silent false negative -- the hit simply is not
# there -- so removing an entry has to be as easy as adding one. It was not:
# CS_EXCLUDE_EXTRA only ever appended. CS_EXCLUDE_REMOVE subtracts.
CS_EXCLUDE_DIRS=(
  .git .origins .hg .svn
  node_modules bower_components vendor Pods DerivedData
  target build dist out bin obj .gradle .m2
  .venv venv __pycache__ .mypy_cache .pytest_cache .tox .ruff_cache
  .next .nuxt .parcel-cache .turbo coverage .nyc_output
  .terraform .serena .tokensave .idea .vscode-test
)
# shellcheck disable=SC2206
[[ -n "${CS_EXCLUDE_EXTRA:-}" ]] && CS_EXCLUDE_DIRS+=(${CS_EXCLUDE_EXTRA})
if [[ -n "${CS_EXCLUDE_REMOVE:-}" ]]; then
  # Separate statements, not `_keep=() _d _r _drop`: outside a function that is
  # an assignment followed by three COMMANDS, and bash 3.2 duly reported
  # "_d: command not found" before carrying on with an empty exclusion list.
  _keep=(); _d=""; _r=""; _drop=0
  for _d in "${CS_EXCLUDE_DIRS[@]}"; do
    _drop=0
    for _r in ${CS_EXCLUDE_REMOVE}; do [[ "$_d" == "$_r" ]] && { _drop=1; break; }; done
    [[ $_drop -eq 0 ]] && _keep+=("$_d")
  done
  # `${a[@]+"${a[@]}"}` rather than `"${a[@]}"`: stock macOS ships bash 3.2,
  # where expanding an EMPTY array under `set -u` is a fatal "unbound variable".
  # Removing every entry is a legitimate thing to ask for, and it must not turn
  # cs into a script that refuses to start.
  CS_EXCLUDE_DIRS=(${_keep[@]+"${_keep[@]}"})
  unset _keep _d _r _drop
fi

# A non-default exclusion list changes which files are searched, and nothing
# said so. The answer line was identical in shape either way -- only the hit
# count moved, and a reader has nothing to compare it against.
#
# `cs engines` already names the hazard ("a directory excluded by mistake looks
# exactly like a directory with no hits"), but only if you run `cs engines`, not
# when it matters. And the delivery mechanism makes it durable: set
# CS_EXCLUDE_EXTRA once in a shell profile for one investigation and every query
# in every later session is narrowed, with no per-query signal and no expiry.
# `app`, `src`, `lib`, `test` are all plausible one-off exclusions and
# disastrous left set -- excluding `app` hid an endpoint's own @router
# declaration while leaving its config mentions and tests, so the result was not
# merely smaller but inverted in character.
#
# The two directions carry opposite risk and are reported separately: EXTRA
# narrows and manufactures false negatives; REMOVE widens and merely adds noise.
CS_EXCLUSION_NOTE=""
if [[ -n "${CS_EXCLUDE_EXTRA:-}" ]]; then
  # sed, not tr: tr maps character-to-character and cannot expand one space
  # into " +", so `-bin vendor` came out unprefixed on the second entry.
  CS_EXCLUSION_NOTE="+$(printf '%s' "${CS_EXCLUDE_EXTRA}" | sed -e 's/^  *//' -e 's/  *$//' -e 's/  */ +/g') (CS_EXCLUDE_EXTRA)"
fi
if [[ -n "${CS_EXCLUDE_REMOVE:-}" ]]; then
  _rm="-$(printf '%s' "${CS_EXCLUDE_REMOVE}" | sed -e 's/^  *//' -e 's/  *$//' -e 's/  */ -/g') (CS_EXCLUDE_REMOVE)"
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then CS_EXCLUSION_NOTE="$CS_EXCLUSION_NOTE, $_rm"
  else CS_EXCLUSION_NOTE="$_rm"; fi
  unset _rm
fi

# `rg` may exist only as a shell function (Claude Code proxies its bundled
# ripgrep that way), which a script cannot call. Require a real binary, and
# fall back to POSIX grep so the facade works on a machine without ripgrep.
have_rg_binary() { [[ -x "$(command -v rg 2>/dev/null || true)" ]]; }

# Which text backend will actually run. CS_TEXT_ENGINE forces one, so the two
# can be compared against each other rather than trusted.
text_engine() {
  case "${CS_TEXT_ENGINE:-auto}" in
    rg|ripgrep) echo ripgrep ;;
    grep|posix)  echo grep ;;
    *) if have_rg_binary; then echo ripgrep; else echo grep; fi ;;
  esac
}

# Run an engine under a wall-clock limit. A language server or a fleet-wide
# structural scan can hang on a real repo, and a search tool that never returns
# is worse than one that says it gave up. macOS has no `timeout` unless GNU
# coreutils is installed, so its absence degrades to running unbounded.
timeout_bin() {
  local t
  for t in timeout gtimeout; do have "$t" && { echo "$t"; return 0; }; done
  return 1
}
# Engines run inside subshells and command substitutions, so a shell variable
# set here would be discarded before anything could report it -- a timeout would
# silently look like "no results", which is the single worst failure mode this
# tool can have. The flag is a file for that reason: it crosses process
# boundaries where a variable cannot.
CS_TIMEOUT_FLAG="$(mktemp -t cs-timeout.XXXXXX)"
run_timed() {
  local tb secs="${CS_TIMEOUT:-120}"
  if [[ "$secs" != 0 ]] && tb=$(timeout_bin); then
    "$tb" "$secs" "$@"
    local rc=$?
    [[ $rc -eq 124 ]] && printf '%s\n' "${secs}s" >> "$CS_TIMEOUT_FLAG"
    return $rc
  fi
  "$@"
}
timed_out() { [[ -s "$CS_TIMEOUT_FLAG" ]]; }

# ---- engine failure --------------------------------------------------------
# A broken engine and an absent one are different problems with the same
# symptom, and only the absent one was handled. `cs engines` reports what is on
# PATH; it cannot report that ripgrep is on PATH and exiting 2 on every query,
# that ast-grep no longer understands its own pattern dialect, or that the regex
# the caller typed does not compile. Every one of those produced no output, and
# every one was then reported as `0 hit(s)` -- and since the exit code now
# separates a refusal from an honest zero, reporting it as an honest zero is a
# stronger lie than it used to be: a caller that correctly branches on 2 gets
# "this search happened and the answer is no" from a search that crashed.
#
# The three text/structural engines share one convention, which is what makes
# this detectable at all:
#
#   ripgrep, POSIX grep, ast-grep:  0 = matched, 1 = no match, >=2 = error
#   semgrep, git:                   0 = ran (match or not), non-zero = error
#
# A file rather than a variable, for the same reason as CS_TIMEOUT_FLAG: engines
# run inside command substitutions, and a variable set there is discarded before
# anything can report it.
CS_ENGINE_ERR_FLAG="$(mktemp -t cs-engine-err.XXXXXX)"
engine_error()       { printf '%s\n' "$*" >> "$CS_ENGINE_ERR_FLAG"; }
engine_failed()      { [[ -s "$CS_ENGINE_ERR_FLAG" ]]; }
engine_error_lines() { sort -u "$CS_ENGINE_ERR_FLAG" 2>/dev/null; }

# ---- unreadable files are PARTIAL, not broken ------------------------------
# ripgrep overloads exit 2: from its own docs 0 = match, 1 = no match, 2 =
# error -- and that one code covers "bad regex", "binary missing", and "could
# not open one file out of 84,000". Only the first two are systemic. The third
# is per-file and routine on any real multi-repo checkout: committed symlinks
# whose targets do not exist on this machine, permission bits, files deleted
# mid-scan, dangling worktree links.
#
# Treating them alike meant one unreadable file anywhere in the fleet made
# every ZERO-HIT query refuse, while queries with hits answered normally. On a
# 37-repo fleet with two broken symlinks in someone else's repo, no negative
# result was obtainable at all -- and "is this dead?" is the question this tool
# is best at. 84,783 of 84,785 files had been searched to completion.
#
# So the two are separated by parsing the stderr cs was already capturing, and
# a per-file failure becomes PARTIAL -- the vocabulary timeouts already use and
# that the skill already tells agents to pass on rather than swallow.
CS_SKIPPED_FLAG="$(mktemp -t cs-skipped.XXXXXX)"
note_skipped()  { printf '%s\n' "$1" >> "$CS_SKIPPED_FLAG"; }
files_skipped() { [[ -s "$CS_SKIPPED_FLAG" ]]; }
skipped_paths() { sed -e "s|^\./||" -e "s|^${view}/||" "$CS_SKIPPED_FLAG" 2>/dev/null | sort -u; }
skipped_count() { skipped_paths | grep -c ''; }

# A per-file read error, across the three spellings that occur in practice:
#   rg:    rg: ./path: No such file or directory (os error 2)
#   grep:  grep: path: Permission denied
#   ugrep: ugrep: warning: ./path: No such file or directory
# The trailing errno phrase is what makes this safe to match on. `rg: regex
# parse error:` and `ugrep: error: error at position 7` both fail it, so a
# systemic failure cannot be mistaken for a skipped file.
CS_PERFILE_RE='^[A-Za-z0-9_.+-]+: (warning: )?(.+): (No such file or directory|Permission denied|Is a directory|Not a directory|Too many levels of symbolic links|Operation not permitted|Input/output error|Device not configured|Bad file descriptor)( \(os error [0-9]+\))?$'

# classify_engine_stderr <stderr-file> -> 0 if every line was per-file, 1 if any
# line was systemic. Systemic lines are passed through to stderr, because an
# uncompilable regex is exactly the message the caller needs to see; per-file
# lines are collected and summarised once instead of printed by the hundred.
classify_engine_stderr() {
  local ef="$1" line systemic=0
  [[ -s "$ef" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    if [[ "$line" =~ $CS_PERFILE_RE ]]; then
      note_skipped "${BASH_REMATCH[2]}"
    else
      systemic=1
      printf '%s\n' "$line" >&2
    fi
  done < "$ef"
  return $systemic
}

# note_search_result <rc> <stderr-file> <engine> <what it was doing>
# For the 0/1/>=2 family (ripgrep, grep, ast-grep). An exit >=2 explained
# entirely by per-file errors is PARTIAL; anything else is a failure.
note_search_result() {
  local rc="${1:-0}" ef="$2" eng="$3" what="$4"
  # A timeout is its own category and run_timed has already flagged it. Filing
  # it as a generic engine failure too would bury the one word the caller is
  # told to look for -- PARTIAL -- under "an engine failed".
  if [[ "$rc" -eq 124 ]] && timed_out; then
    classify_engine_stderr "$ef" >/dev/null 2>&1 || true
    return 0
  fi
  if classify_engine_stderr "$ef"; then
    # Every message accounted for as a skipped file. An exit >=2 with NO
    # explanation at all is still a failure -- silence is not evidence of
    # health, and that is the case where the engine simply did not run.
    if [[ "$rc" -ge 2 ]] && ! files_skipped; then
      engine_error "$eng exited $rc while $what (no diagnostic)"
    fi
  else
    engine_error "$eng exited $rc while $what"
  fi
  return 0
}

# note_grep_status <rc> <engine> <what it was doing>
# For the 0/1/>=2 family. 1 is a real "no match" and must stay silent.
note_grep_status() {
  [[ "${1:-0}" -ge 2 ]] && engine_error "$2 exited $1 while $3"
  return 0
}
# note_run_status <rc> <engine> <what it was doing>
# For engines that report 0 whether or not they matched.
note_run_status() {
  [[ "${1:-0}" -ne 0 ]] && engine_error "$2 exited $1 while $3"
  return 0
}

# Called at every zero-hit branch, before the emptiness is reported as an
# answer. This is the structural-tier twin of serena_answered_or_die.
engines_ok_or_die() {  # <subcommand>
  # Only SYSTEMIC failures refuse. A per-file read error has already been
  # recorded as a skipped path, and a zero-hit result that skipped two dangling
  # symlinks is still an answer -- refusing there blocked every negative on the
  # whole fleet over two files that had nothing to do with the query.
  scan_unreadable_for_grep
  # A run that did not finish has not established a negative, so it refuses --
  # but it refuses in the PARTIAL vocabulary, which is the word the skill tells
  # an agent to look for and pass on.
  if timed_out; then
    die "cs $1: an engine hit the ${CS_TIMEOUT:-120}s timeout and found nothing — PARTIAL, not an answer
  the search did not finish, so nothing was ruled out; raise CS_TIMEOUT and rerun"
  fi
  engine_failed || return 0
  die "cs $1: an engine failed, so this empty result is not an answer
$(engine_error_lines | sed 's/^/  /')
  nothing here was searched to completion, and a zero-hit result from a broken
  engine is precisely the manufactured negative this tool exists to prevent
  check: cs engines   (which engines are present, and which answer kinds work)
  if you passed a regex, check it compiles: cs text needs a valid pattern"
}

# grep_fleet <regex|literal> <pattern>
#
# The mode is named rather than passed as a flag, because the two backends do
# NOT share a flag vocabulary and assuming they did was a real bug: `-E` means
# --extended-regexp to grep and --encoding to ripgrep, so every `cs text` query
# died with "unknown encoding" and reported "nothing found". It went unnoticed
# because the machine it was written on had no ripgrep binary, which is the
# whole argument for the parity check in verify-search.
grep_fleet() {
  local mode="$1" pattern="$2" engine
  engine=$(text_engine)
  # An empty array expanded under `set -u` is an error on bash 3.2, which is
  # what macOS ships, so the mode flag is always a single value rather than a
  # possibly-empty list.
  local extra="--regexp"
  # --word is opt-in rather than the default. Both backends spell it -w and both
  # agree on it (checked against the scored queries), but making it the DEFAULT
  # would drop `reserve` inside `reserveItem` -- a real use, silently lost. That
  # trades one false-negative class for another in a tool organised against
  # them, so the boundary information is computed and REPORTED instead, and the
  # flag is there for callers who want identifier-strict matching.
  local wordflag=()
  [[ $word_match -eq 1 ]] && wordflag=(-w)
  if [[ "$engine" == ripgrep ]]; then
    # ripgrep is a regex engine by default; -F restricts it to a literal.
    [[ "$mode" == literal ]] && extra="--fixed-strings"
  else
    case "$mode" in
      literal) extra="-F" ;;
      regex)   extra="-E" ;;
    esac
  fi
  # Captured rather than discarded (grep) or let through to the terminal (rg):
  # it is the only thing that separates "could not open one file" from "the
  # regex does not compile", and both arrive as exit 2.
  local rc=0 err_f
  err_f=$(mktemp -t "cs-engerr.$$")
  if [[ "$engine" == ripgrep ]]; then
    # --regexp is ripgrep's default, so pass a harmless flag instead of none.
    [[ "$extra" == "--regexp" ]] && extra="--no-config"
    local globs=() d
    for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do globs+=(--glob "!**/$d/**" --glob "!$d/**"); done
    (cd "$view" && run_timed rg --follow --hidden --no-ignore \
        --no-heading --line-number --color=never \
        ${globs[@]+"${globs[@]}"} ${wordflag[@]+"${wordflag[@]}"} "$extra" -- "$pattern" .) 2>"$err_f"
    rc=$?
    # 1 is "no match" and must stay silent; 2 is either an uncompilable regex
    # (systemic, refuse) or an unreadable file (per-file, PARTIAL).
    note_search_result "$rc" "$err_f" ripgrep "searching for '$pattern'"
  else
    # BSD grep's -R follows a symlink named on the command line but NOT one it
    # meets while recursing, so `grep -R pattern .` silently finds nothing in a
    # view made of symlinks. Passing the repo directories explicitly with a
    # trailing slash works on both BSD and GNU grep and does not depend on
    # symlink-following semantics at all.
    local ex=() d
    for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do ex+=("--exclude-dir=$d"); done
    run_timed grep -Rn --binary-files=without-match \
        ${ex[@]+"${ex[@]}"} ${wordflag[@]+"${wordflag[@]}"} "$extra" -- "$pattern" "$view"/*/ 2>"$err_f"
    rc=$?
    note_search_result "$rc" "$err_f" grep "searching for '$pattern'"
  fi
  rm -f "$err_f"
  return $rc
}

# Recursive grep skips a dangling symlink SILENTLY -- it never reports the file
# ripgrep exits 2 over -- so the same fleet yields a clean negative on one
# backend and a PARTIAL one on the other. A negative has to mean the same thing
# whichever engine happens to be installed, which is the property verify-search
# already asserts for results and did not assert for what was skipped.
#
# Only run when it can change what an answer MEANS: on the grep backend, when
# the query found nothing and grep reported nothing. That is the one case where
# a silent skip turns into a false "this is dead", and it keeps a whole extra
# filesystem walk off every query that already has an answer.
scan_unreadable_for_grep() {
  [[ "$(text_engine)" == grep ]] || return 0
  files_skipped && return 0
  local prune=() d first=1
  for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do
    if [[ $first -eq 1 ]]; then prune+=(-name "$d"); first=0
    else prune+=(-o -name "$d"); fi
  done
  # -L makes find follow symlinks, so one that still reports as -type l is a
  # symlink whose target does not resolve: exactly the file grep passed over.
  while IFS= read -r d; do
    [[ -n "$d" ]] && note_skipped "$d"
  done < <(find -L "$view"/*/ \( "${prune[@]}" \) -prune -o -type l -print 2>/dev/null)
}
ctags_bin() {
  # On macOS, Homebrew's universal-ctags is shadowed by the BSD ctags in
  # /usr/bin, which is a different program with a different output format --
  # so check for the Universal banner rather than trusting the name.
  local c
  for c in /opt/homebrew/bin/ctags /usr/local/bin/ctags /usr/bin/ctags-universal \
           "$(command -v ctags 2>/dev/null || true)"; do
    [[ -n "$c" && -x "$c" ]] || continue
    if "$c" --version 2>&1 | grep -qi universal; then echo "$c"; return 0; fi
  done
  return 1
}

# ---- language toolchains ---------------------------------------------------
# Serena is a DRIVER for a language server, and a language server needs its
# language's toolchain: a .NET SDK to load a C# project, a JVM for Java or
# Kotlin, node for TypeScript. The preflight in `cs refs` / `cs impls` used to
# check uvx, python3 and the repo directory -- the driver and its plumbing, none
# of which say anything about whether the language can be analysed. All three
# passed on a machine with no SDK, the server loaded nothing, and the empty
# result was printed as
#
#     answer: resolved via serena (LSP) · 0 hit(s)
#
# which is the STRONGEST negative this tool can emit ("no reference, within that
# one repo"), asserted about a repo where nothing had been read. That is the
# failure mode the project exists to prevent, reproduced inside the tool.
#
# `bootstrap` already probed dotnet and java and said "Serena cannot analyse
# that language" -- but bootstrap is optional and its knowledge never reached
# the query path. This is that knowledge, moved to where the query is.
#
# Probed by RUNNING the binary, not by `command -v` alone, for the same reason
# require_python3 does: "on PATH but fails to run" is a real state, and it is
# indistinguishable from a working toolchain until a query comes back empty.
have_toolchain() {
  command -v "$1" >/dev/null 2>&1 || return 1
  case "$1" in
    java) java -version >/dev/null 2>&1 ;;   # JDK 8 has no --version
    *)    "$1" --version >/dev/null 2>&1 ;;
  esac
}

# The mapping is deliberately short. A toolchain named here and absent produces
# a REFUSAL, so a wrong entry blocks a query that would have worked -- which is
# its own kind of damage. These three are the runtimes the server itself cannot
# start without; a language not listed is not preflighted, and `cs why resolved`
# says so rather than implying the check was made.
language_toolchain() {  # <language> -> the binary its language server needs
  case "$1" in
    csharp)                echo dotnet ;;
    java|kotlin)           echo java ;;
    typescript|javascript) echo node ;;
    *) return 1 ;;
  esac
}
toolchain_languages() {  # <toolchain> -> the languages it unblocks, for messages
  case "$1" in
    dotnet) echo "C#" ;;
    java)   echo "Java/Kotlin" ;;
    node)   echo "TypeScript/JavaScript" ;;
  esac
}
toolchain_install() {
  case "$1" in
    dotnet) echo "brew install --cask dotnet-sdk   (or https://dot.net)" ;;
    java)   echo "brew install openjdk             (any JDK)" ;;
    node)   echo "brew install node" ;;
  esac
}
CS_TOOLCHAINS="dotnet java node"

# The dominant source language of a repo, or nothing if it cannot be told.
#
# Extension counts, walked in rank order rather than taking the single commonest
# extension: a repo's most numerous file type is often .json or .yml, which
# names no language at all. The first ranked extension that IS a language wins.
repo_language() {
  local dir="$1" ranked n ext
  ranked=$(find -L "$dir" -type d \( -name .git -o -name node_modules -o -name vendor \
             -o -name target -o -name build -o -name dist -o -name obj -o -name bin \
             -o -name .venv -o -name __pycache__ \) -prune -o -type f -print 2>/dev/null \
           | sed -n 's/.*\.\([A-Za-z0-9_]\{1,\}\)$/\1/p' \
           | tr 'A-Z' 'a-z' | sort | uniq -c | sort -rn)
  [[ -n "$ranked" ]] || return 1
  while read -r n ext; do
    [[ -n "$ext" ]] || continue
    case "$ext" in
      cs)             echo csharp;     return 0 ;;
      java)           echo java;       return 0 ;;
      kt|kts)         echo kotlin;     return 0 ;;
      ts|tsx)         echo typescript; return 0 ;;
      js|jsx|mjs|cjs) echo javascript; return 0 ;;
      py)             echo python;     return 0 ;;
      go)             echo go;         return 0 ;;
      rs)             echo rust;       return 0 ;;
    esac
  done <<EOF
$ranked
EOF
  return 1
}

# require_serena_toolchain <subcommand> <symbol> <repo-name> <repo-dir>
#
# Refuses rather than answering, and refuses BEFORE `answer resolved` is set, so
# there is no path on which the label reaches stdout for a query that could not
# have run.
# The missing toolchain for a repo's language, or empty if it can be analysed.
# Split out of require_serena_toolchain so a caller can offer a fallback instead
# of only refusing -- installing the SDK is not a fix for every repo, and where
# it is not, refusing was cs's ONLY answer.
serena_missing_toolchain() {  # <repo-dir>
  local lang tc
  lang=$(repo_language "$1") || return 1
  tc=$(language_toolchain "$lang") || return 1
  have_toolchain "$tc" && return 1
  printf '%s\n' "$tc"
}

# ---- the graph fallback ----------------------------------------------------
# `resolved` needs a language server, and a language server needs its language's
# toolchain. For .NET Framework C# that toolchain is Windows-only to build, so
# on macOS or Linux the tier is unavailable BY CONSTRUCTION rather than for want
# of installing something -- and cs had no answer at all for those repos, not a
# degraded one.
#
# A prebuilt graph is the profile the facade is otherwise missing: offline,
# cross-repo, no per-language toolchain. It is NEVER labelled `resolved`: a
# symbol graph cannot see reflection, DI registration, or generated code, and
# `cs refs` remains the only thing that bridges a DI registration. Calling a
# graph answer `resolved` would overstate it in precisely the way this project's
# answer-kind vocabulary exists to prevent, so it is `structural`.
tokensave_graph_at() { [[ -f "$1/.tokensave/tokensave.db" ]]; }

# Epoch seconds of the graph's last sync, or empty. A graph is the one engine
# here that can be confidently WRONG rather than merely blind -- it answers
# about the code as of its last sync -- so its age is surfaced, not assumed.
# `status` takes its path POSITIONALLY and rejects --project, unlike the `tool`
# subcommands; and --json avoids ~36KB of ANSI art for a handful of numbers.
tokensave_graph_epoch() {
  have_tokensave || return 1
  tokensave status "$1" --json 2>/dev/null \
    | sed -n 's/.*"last_updated"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1
}
tokensave_graph_age_days() {
  local e now
  e=$(tokensave_graph_epoch "$1") || return 1
  [[ -n "$e" ]] || return 1
  now=$(date +%s)
  printf '%s\n' $(( (now - e) / 86400 ))
}

require_serena_toolchain() {
  local sub="$1" sym="$2" repo="$3" dir="$4" lang tc
  if ! lang=$(repo_language "$dir"); then
    warn "could not tell what language $repo is written in — if Serena cannot load it, an empty result here would look like a clean negative (cs why resolved)"
    return 0
  fi
  if ! tc=$(language_toolchain "$lang"); then
    # Not preflighted rather than known-good. Said out loud, because silence
    # here would read as "checked and fine".
    warn "$repo looks like $lang, which cs does not preflight — if Serena cannot analyse it, this returns empty rather than refusing (cs why resolved)"
    return 0
  fi
  have_toolchain "$tc" && return 0
  die "cs $sub cannot analyse $repo: it is $lang, and Serena needs $tc to load it
  $tc is missing or not runnable, so the language server would start, fail to
  load the project, and return nothing — which cs would have labelled
  'resolved · 0 hit(s)', the strongest negative in the taxonomy, about a repo
  where nothing was read. Refusing instead.
  install it: $(toolchain_install "$tc")
  check:      cs engines   (per-kind availability, including this)
  where the toolchain cannot be installed at all (.NET Framework is Windows-only
  to build), a tokensave graph answers cs impls without one:
    cd $repo && tokensave init
  weaker but available now:
    cs def $sym $repo      (structural: ctags, matches spelling not identity)
    cs uses '$sym'         (heuristic: text, comments filtered — cs why heuristic)"
}

# Normalize "path:line:text" to "path:line: text" with the fleet prefix removed.
normalize() { sed -e "s|^${view}/||" -e "s|^${root}/||" -e 's|^\./||'; }

# ---- answer provenance -----------------------------------------------------
# Scoring 9/9 on a fixture means the test set is exhausted, not that search is
# solved: on a real repo some questions are undecidable statically at any
# budget -- an implementation chosen from a config string, an identifier built
# by concatenation, a route assembled at runtime. A tool that cannot reach
# those should not be silent about it.
#
# So every answer carries its KIND, which is what decides whether you can act
# on it and, more importantly, what a NEGATIVE result is worth. "cs uses found
# nothing" is weak evidence of no callers; "cs refs found nothing" is strong.
# The kinds, in descending order of weight:
#
#   resolved    a language server resolved the symbol. Same symbol, not merely
#               the same spelling. The only kind that survives a rename.
#   declared    read from a build manifest. Authoritative for what a repo
#               publishes and depends on, because that is where it is stated.
#   structural  a parser matched a syntax shape. The shape is real; whether two
#               matches mean the same entity is not checked.
#   historical  git history. Authoritative about the past of tracked files.
#   heuristic   a text match with prose filtered out. Best effort at "is this a
#               use", and the filter can be wrong in both directions.
#   textual     a byte or regex match. An occurrence, which is not a use.
CS_KIND=""; CS_ENGINE=""; CS_NOTE=""; CS_TRUNCATED=""; CS_DEGRADED=""

answer() { CS_KIND="$1"; CS_ENGINE="$2"; CS_NOTE="${3:-}"; }

blind_spots() {
  case "$1" in
    resolved) cat <<'X'
Cannot see: a type chosen at runtime from configuration or reflection; code the
language server failed to load (an unresolved build is the usual reason, and it
degrades quietly); anything outside the one repo the server was pointed at.
A negative here is strong evidence -- but only within that repo, and only if
the project actually built.
X
;;
    declared) cat <<'X'
Cannot see: dependencies injected by a parent build file, a BOM, or a plugin
rather than declared in the manifest; vendored code with no coordinate at all;
version ranges resolved at build time. States what the manifest says, which is
not always what is on the classpath.

For `cs versions`: a lockfile, not the manifest, decides what is actually
installed, and two repos agreeing in the manifest can still resolve differently.
Ranges are compared by their written form, not by what they resolve to.

For `cs owns`: CODEOWNERS names who is REQUIRED TO REVIEW, which is not who
wrote the code, who understands it, or who is still at the company. A repo with
no CODEOWNERS produces no answer rather than "nobody owns it", and the rule that
matched is printed so you can judge whether it was meant to cover your file.
X
;;
    structural) cat <<'X'
Cannot see: two matches that resolve to different entities -- it matches shape,
not identity, so a same-named method on an unrelated class matches too. Cannot
see calls made through an alias, a wrapper, or reflection. Coverage is
per-language and uneven; a language the parser does not support returns nothing
rather than an error.
X
;;
    historical) cat <<'X'
Cannot see: anything untracked, anything in a repo not in the view, or a change
that never took this exact string form (a rename that also reformatted). Finds
where a string entered or left history, which is not always where the behaviour
changed.
X
;;
    heuristic) cat <<'X'
Cannot see: a use assembled from parts ("/api/v1/" + resource), a value read
from configuration, or a generated call site. Also over-reports: a string in a
test fixture or a dead branch counts as a use. The prose filter is per-file
comment-state tracking, so an unusual comment syntax can misclassify a line in
either direction. A negative is weak evidence of absence.
X
;;
    textual) cat <<'X'
Cannot see: anything not spelled exactly this way -- concatenation, interpolation,
a constant holding the value, generated code. Counts comments, docs, changelogs
and test fixtures as hits. This is an occurrence, not a use; a negative is weak
evidence of absence.
X
;;
    *) return 1 ;;
  esac
}

# ---- which answer kinds are reachable on this machine -----------------------
# `cs engines` reported which BINARIES were present. The contract is expressed
# in answer KINDS, and nothing connected the two, so translating
#
#     ast-grep     MISSING
#     semgrep      MISSING
#
# into the fact that actually matters -- the whole `structural` tier is gone and
# `cs calls` will refuse -- required already knowing the routing table. Five
# rows saying `ok` next to two saying MISSING reads as a healthy install.
#
# It matters because the skill tells the agent to weigh every negative by its
# kind, and marks heuristic weak and textual weakest. "Which kinds can I get
# right now" therefore decides whether a negative from this machine is worth
# anything at all -- and there is a realistic configuration (no ast-grep, no
# semgrep, no language toolchain) where BOTH strong code-derived kinds are gone
# and nothing says so.
#
# So the routing table is written down once, here, and `cs engines` and `cs why`
# both read it instead of keeping their own hand-maintained lists.
kind_subcommands() {
  case "$1" in
    resolved)   echo "cs impls, cs refs" ;;
    declared)   echo "cs provides, cs deps, cs publishes, cs versions, cs owns" ;;
    structural) echo "cs calls, cs def, cs impls (graph fallback)" ;;
    historical) echo "cs history" ;;
    heuristic)  echo "cs uses" ;;
    textual)    echo "cs text, cs seam" ;;
  esac
}

# Roll-call of the language toolchains Serena needs, e.g.
# "dotnet ok, java MISSING (Java/Kotlin), node ok".
toolchain_roll_call() {
  local tc out=""
  for tc in $CS_TOOLCHAINS; do
    if have_toolchain "$tc"; then out="$out, $tc ok"
    else out="$out, $tc MISSING ($(toolchain_languages "$tc"))"; fi
  done
  printf '%s\n' "${out#, }"
}

# kind_status <kind> -> "<state>|<detail>", state in ok|degraded|unavailable.
#
# `degraded` is a third state on purpose, and keeping it separate from
# `unavailable` is the point: ripgrep absent still yields `textual` through the
# POSIX grep fallback, which is a slower route to the same kind, not a missing
# kind. Collapsing the two would either hide a real gap or invent one.
kind_status() {
  local n_missing=0 n_present=0 tc
  case "$1" in
    resolved)
      if ! have uvx; then
        echo "unavailable|needs uv — Serena runs via uvx and it is not installed → cs impls / cs refs refuse"
        return
      fi
      for tc in $CS_TOOLCHAINS; do
        if have_toolchain "$tc"; then n_present=$((n_present + 1)); else n_missing=$((n_missing + 1)); fi
      done
      if [[ $n_missing -eq 0 ]]; then
        echo "ok|serena (LSP) via uvx; toolchains: $(toolchain_roll_call)"
      elif [[ $n_present -eq 0 ]]; then
        echo "unavailable|serena needs a toolchain per language and none are runnable: $(toolchain_roll_call) → cs impls / cs refs refuse for every preflighted language"
      else
        local _fb=""
        have_tokensave && _fb="; a tokensave graph answers cs impls (as structural) where a toolchain is missing"
        echo "degraded|$(toolchain_roll_call) → cs impls / cs refs refuse for the missing languages$_fb"
      fi
      ;;
    declared)
      if have_python3; then echo "ok|python3 reads the build manifests and CODEOWNERS"
      else echo "unavailable|needs python3, which is not runnable → cs provides / deps / publishes / versions / owns refuse"; fi
      ;;
    structural)
      # Two independent backers behind one kind: ast-grep-or-semgrep answers
      # `cs calls`, ctags answers `cs def`. Losing one is not losing the tier,
      # so the consequence is named per subcommand rather than per kind.
      local have_calls=0 have_def=0
      { have ast-grep || have semgrep; } && have_calls=1
      ctags_bin >/dev/null 2>&1 && have_def=1
      if [[ $have_calls -eq 1 && $have_def -eq 1 ]]; then
        if have_tokensave; then
          echo "ok|ast-grep/semgrep for cs calls, ctags for cs def, tokensave graph for cs impls without a toolchain"
        else
          echo "ok|ast-grep/semgrep for cs calls, ctags for cs def"
        fi
      elif [[ $have_calls -eq 0 && $have_def -eq 0 ]]; then
        echo "unavailable|needs ast-grep or semgrep, and universal-ctags — none installed → cs calls and cs def both refuse"
      elif [[ $have_calls -eq 0 ]]; then
        echo "degraded|neither ast-grep nor semgrep installed → cs calls refuses; cs def still answers via ctags"
      else
        echo "degraded|universal-ctags not installed → cs def refuses; cs calls still answers"
      fi
      ;;
    historical)
      if have git; then echo "ok|git log -S / -G"
      else echo "unavailable|needs git, which is not installed → cs history refuses"; fi
      ;;
    heuristic)
      if have_python3; then echo "ok|$(text_engine) plus the python3 prose filter"
      else echo "unavailable|the prose filter needs python3, which is not runnable → cs uses refuses"; fi
      ;;
    textual)
      if have_rg_binary; then echo "ok|ripgrep"
      else echo "degraded|no ripgrep binary — POSIX grep fallback, same results, slower"; fi
      ;;
  esac
}

# The kinds view, shared by `cs engines` and `cs why`. Two lines per kind: what
# you can get, then what you lose if you cannot get it.
print_kinds_table() {
  local kind row state detail
  printf '%-12s %s\n' "ANSWER KIND" "STATUS"
  for kind in resolved declared structural historical heuristic textual; do
    row=$(kind_status "$kind")
    state="${row%%|*}"; detail="${row#*|}"
    [[ "$state" == ok ]] || state=$(printf '%s' "$state" | tr 'a-z' 'A-Z')
    printf '%-12s %s — %s\n' "$kind" "$state" "$detail"
    printf '%-12s   backs: %s\n' "" "$(kind_subcommands "$kind")"
  done
}

# Print the provenance line. Goes to stderr, so stdout stays exactly the
# scoreable "repo/path:line: text" stream every caller and score-seams expect.
report_answer() {
  local hits="${1:-}" repos="${2:-}"
  # Recorded before the early return, because --quiet suppresses the human line
  # and must not also empty the porcelain envelope.
  CS_HITS="$hits"; CS_REPOS="$repos"
  # An engine that failed but still produced output means the results are a
  # subset of the truth, exactly like a timeout. Said out loud rather than left
  # to look complete; the empty case refuses instead, via engines_ok_or_die.
  # Only when it differs from the default: a warning that fires on every run is
  # noise and gets ignored, so this one has to mean "something unusual is in
  # force". EXTRA is the dangerous direction and is called out as such.
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then
    if [[ -n "${CS_EXCLUDE_EXTRA:-}" ]]; then
      warn "searching with a NON-DEFAULT exclusion list: $CS_EXCLUSION_NOTE — files under those directories were not searched, so this result may be narrower than the fleet"
    else
      warn "searching with a non-default exclusion list: $CS_EXCLUSION_NOTE"
    fi
  fi
  if engine_failed; then
    warn "an engine failed during this query; these results are INCOMPLETE:"
    engine_error_lines | sed 's/^/  /' >&2
  fi
  # Named, not merely counted. Two broken symlinks cannot hide a symbol; a
  # skipped directory of 400 files might, and only the paths let a reader tell
  # those apart. Capped so a fleet with thousands of them stays readable.
  if files_skipped; then
    local n; n=$(skipped_count)
    warn "$n file(s) could not be read and were skipped; this result is PARTIAL:"
    skipped_paths | head -10 | sed 's/^/  /' >&2
    [[ "$n" -gt 10 ]] && info "  … and $((n - 10)) more"
  fi
  [[ $quiet -eq 1 || -z "$CS_KIND" ]] && return 0
  local line="${C_BOLD}answer:${C_OFF} $CS_KIND via $CS_ENGINE"
  [[ -n "$CS_NOTE" ]] && line="$line ($CS_NOTE)"
  [[ -n "$hits" ]] && line="$line · $hits hit(s)"
  [[ -n "$repos" ]] && line="$line · $repos repo(s)"
  info "$line"
  [[ -n "$CS_DEGRADED" ]] && warn "degraded: $CS_DEGRADED"
  if timed_out; then
    warn "an engine hit the ${CS_TIMEOUT:-120}s timeout $(grep -c '' "$CS_TIMEOUT_FLAG") time(s); these results are PARTIAL, not complete (raise CS_TIMEOUT)"
  fi
  if [[ -n "$CS_TRUNCATED" ]]; then
    warn "showing $CS_MAX_RESULTS of $CS_TRUNCATED — rerun with --all, or narrow the query"
  fi
  if [[ $show_why -eq 1 ]]; then
    info ""
    blind_spots "$CS_KIND" >&2
  else
    info "  ${C_BOLD}--why${C_OFF} for what a $CS_KIND answer cannot see"
  fi
}

# Print at most CS_MAX_RESULTS lines. A fleet-wide query for a common token can
# return tens of thousands of lines on real repos; dumping those into an agent's
# context is worse than saying how many there were and where they live.
emit_capped() {
  local out="$1" total
  total=$(printf '%s\n' "$out" | grep -c '' )
  if [[ "${CS_MAX_RESULTS:-200}" -gt 0 && "$total" -gt "${CS_MAX_RESULTS}" ]]; then
    emit_plain "$(printf '%s\n' "$out" | head -n "$CS_MAX_RESULTS")"
    CS_TRUNCATED="$total"
    # When truncating, the distribution is the useful part of what was cut.
    info ""
    info "${C_BOLD}hits per repo (all $total, not just those shown):${C_OFF}"
    printf '%s\n' "$out" | cut -d/ -f1 | sort | uniq -c | sort -rn | sed 's/^/  /' >&2
  else
    emit_plain "$out"
  fi
}

# The single door to stdout. In porcelain mode the lines are buffered into the
# JSON envelope instead of printed, so that stdout carries exactly one object
# and no subcommand has to know which mode it is running in.
emit_plain() {
  # stdout is the result stream, one hit per line and nothing else -- so an
  # empty result writes ZERO bytes, not a bare newline. `printf '%s\n' ""`
  # emitted one byte, which made `cs deps | wc -l` report 1 for no results.
  [[ -n "$1" ]] || return 0
  if [[ $porcelain -eq 1 ]]; then
    if [[ -n "$CS_RESULTS" ]]; then CS_RESULTS="$CS_RESULTS
$1"; else CS_RESULTS="$1"; fi
  else
    printf '%s\n' "$1"
  fi
}

# Of these hit lines, the subset where the pattern matched as a WHOLE
# identifier rather than inside a longer one.
#
# `cs seam`'s orphan warning -- "only one repo mentions this, a producer with no
# consumer, or dead" -- is this tool's dead-code detector, and a SUBSTRING match
# in an unrelated repo silently removed it. A queue handler named
# AccessionUpdateIn stopped looking dead because a different repo declared a
# GraphQL type called AccessionUpdateInput. The consequence is inverted from a
# normal false positive: extra hits do not add noise, they delete a warning, and
# the reading flips from "this looks dead" to "two repos use it, leave it alone".
# Names of that shape -- FooIn/FooInput, Handler/HandlerFactory, Update/
# UpdateRequest -- are ordinary, so any identifier that is a prefix of a longer
# one anywhere in the fleet lost its warning.
#
# The prefix is stripped before testing, so a pattern occurring in a FILE NAME
# cannot pass itself off as a whole-identifier hit in the code.
#
# The line numbers are passed as a FILE, not through `awk -v`. POSIX leaves a
# literal newline in a -v operand undefined; BSD awk -- /usr/bin/awk on macOS --
# rejects it outright with "newline in string", exits 2, and writes nothing.
# That made this function return empty for every query with TWO OR MORE
# whole-word hits, and an empty result here reads as "no repo mentions this as a
# whole identifier": the orphan warning. A live cross-repo seam was reported as
# dead, which is the inverse of the bug this function was added to fix and the
# outcome the whole project exists to prevent.
#
# It survived a 79-check run because every fixture query yielded at most ONE
# whole-word hit, so `keep` was always a single line and -v behaved. Invisible
# below two matches, certain at or above -- hence the multi-hit fixture cases in
# verify-search.
#
# Returns awk's exit status, so the caller can tell "no whole-word hits" from
# "the analysis did not run". An empty result from a broken helper is not an
# answer, which is the rule cs already applies to ripgrep and filter_code.py.
whole_word_hits() {  # <pattern>, hit lines on stdin
  local pat="$1" all stripped keep tmp rc
  all=$(cat)
  [[ -n "$all" ]] || return 0
  stripped=$(printf '%s\n' "$all" | sed 's/^[^:]*:[0-9]*: \{0,1\}//')
  keep=$(printf '%s\n' "$stripped" | grep -nwF -- "$pat" 2>/dev/null | cut -d: -f1)
  [[ -n "$keep" ]] || return 0
  tmp=$(mktemp -t "cs-word.$$")
  printf '%s\n' "$keep" > "$tmp"
  printf '%s\n' "$all" | awk 'NR == FNR { want[$1] = 1; next } want[FNR]' "$tmp" -
  rc=$?
  rm -f "$tmp"
  return $rc
}

n_repos_in() { printf '%s\n' "$1" | cut -d/ -f1 | sort -u | grep -c ''; }
n_hits_in()  { printf '%s\n' "$1" | grep -c ''; }

# Print the comment header verbatim, so usage cannot drift from the file.
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit "${1:-0}"
}

cmd_engines() {
  local n=0
  printf '%-12s %s\n' "ENGINE" "STATUS"
  # Listed first, and separately from the optional engines below, because it is
  # the only REQUIRED one: the others degrade to each other, python3 does not.
  # Its absence used to be invisible here, which is why `cs uses` on a machine
  # without it looked like a working search that found nothing.
  if have_python3; then printf '%-12s %s\n' "python3" "ok (REQUIRED by: uses, provides, deps, publishes)"
  else printf '%-12s %s\n' "python3" "MISSING — REQUIRED: uses/provides/deps/publishes cannot run"; fi
  if have_rg_binary; then printf '%-12s %s\n' "ripgrep" "ok"; n=$((n+1))
  else printf '%-12s %s\n' "ripgrep" "absent - using POSIX grep fallback"; fi
  for e in ast-grep semgrep; do
    if have "$e"; then printf '%-12s %s\n' "$e" "ok"; n=$((n+1))
    else printf '%-12s %s\n' "$e" "MISSING"; fi
  done
  if ctags_bin >/dev/null; then printf '%-12s %s\n' "ctags" "ok ($(ctags_bin))"; n=$((n+1))
  else printf '%-12s %s\n' "ctags" "MISSING (brew install universal-ctags)"; fi
  if have uvx; then printf '%-12s %s\n' "serena" "ok (via uvx)"; n=$((n+1))
  else printf '%-12s %s\n' "serena" "MISSING (needs uv)"; fi
  if have git; then printf '%-12s %s\n' "git" "ok (cs history)"; n=$((n+1))
  else printf '%-12s %s\n' "git" "MISSING (cs history unavailable)"; fi
  # Reported with its AGE, because a graph is the only engine here that answers
  # about the code as of its last sync -- it can be confidently wrong rather
  # than merely blind, and nothing else in this table has that failure mode.
  if have_tokensave; then
    local g_n=0 g_oldest="" g_age d
    for d in $(real_dirs); do
      tokensave_graph_at "$d" || continue
      g_n=$((g_n + 1))
      g_age=$(tokensave_graph_age_days "$d") || continue
      [[ -n "$g_age" ]] || continue
      if [[ -z "$g_oldest" || "$g_age" -gt "$g_oldest" ]]; then g_oldest="$g_age"; fi
    done
    if [[ $g_n -eq 0 ]]; then
      printf '%-12s %s\n' "tokensave" "ok, but no repo has a graph (cd <repo> && tokensave init) — cs impls has no fallback where a toolchain is missing"
    else
      printf '%-12s %s\n' "tokensave" "ok ($g_n repo graph(s), oldest ${g_oldest:-?} day(s) old; backs cs impls where no language server can run)"
    fi
  else
    printf '%-12s %s\n' "tokensave" "absent (optional: backs cs impls for a repo whose language toolchain cannot be installed)"
  fi
  # Serena is a driver, not an analyser: uvx present says nothing about whether
  # a C# or Kotlin project can be LOADED. Reported here so the gap is visible
  # before a query is run, rather than only after one returns empty.
  local tc
  for tc in $CS_TOOLCHAINS; do
    if have_toolchain "$tc"; then
      printf '%-12s %s\n' "$tc" "ok (Serena can analyse $(toolchain_languages "$tc"))"
    else
      printf '%-12s %s\n' "$tc" "MISSING — Serena cannot analyse $(toolchain_languages "$tc"); cs impls/refs refuse there"
    fi
  done

  # Binaries are not the fact a caller needs. This is.
  printf '\n'
  print_kinds_table

  printf '\nfleet root:  %s\n' "$root"
  printf 'text engine: %s\n' "$(text_engine)"
  printf 'result cap:  %s\n' \
    "$([[ "${CS_MAX_RESULTS:-200}" -eq 0 ]] && echo "none" || echo "${CS_MAX_RESULTS:-200} (CS_MAX_RESULTS, or --all)")"
  if timeout_bin >/dev/null; then
    printf 'timeout:     %ss (CS_TIMEOUT)\n' "${CS_TIMEOUT:-120}"
  else
    printf 'timeout:     %s\n' "NONE — no timeout(1) on this machine, so a hung engine hangs cs (brew install coreutils)"
  fi
  # Printed because every entry here is a place results cannot come from, and a
  # directory excluded by mistake looks exactly like a directory with no hits.
  printf 'skipping:    %s\n' "$(printf '%s ' ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"})"
  printf '             (CS_EXCLUDE_EXTRA adds, CS_EXCLUDE_REMOVE subtracts)\n'
  # Exits 0 whatever it found. Under the exit-code contract, 1 means "the query
  # did not run" -- and a diagnostic that ran, printed a full report, and then
  # claimed to have refused is exactly the confusion the codes exist to remove.
  # What is missing is in the report; the status says only that reporting worked.
  [[ $n -gt 0 ]] || warn "no optional engine is installed — see the ANSWER KIND table above for what that costs"
  return 0
}

hint() {
  info ""; info "${C_BOLD}nothing found — try:${C_OFF}"
  while [[ $# -gt 0 ]]; do
    info "  $1"
    if [[ -n "$CS_HINTS" ]]; then CS_HINTS="$CS_HINTS
$1"; else CS_HINTS="$1"; fi
    shift
  done
}

cmd_text() {
  [[ $# -ge 1 ]] || die "cs text <pattern>"
  answer textual "$(text_engine)" "regex"
  local out; out=$(grep_fleet regex "$1" | normalize)
  if [[ -z "$out" ]]; then
    engines_ok_or_die text
    report_answer 0 0
    hint "cs def $1              (it may be a symbol, not literal text)" \
         "cs calls '<pattern>'   (it may only appear as a call shape)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# A seam is a string two repos share. Grouping by repo is the answer -- a flat
# hit list buries the fact that only one repo mentions it (a dead seam) or that
# three do (a fan-out nobody expected).
cmd_seam() {
  [[ $# -ge 1 ]] || die "cs seam <string>"
  answer textual "$(text_engine)" "literal, grouped by repo"
  local hits repos n
  hits=$(grep_fleet literal "$1" | normalize)
  if [[ -z "$hits" ]]; then
    info "no repo mentions '$1'"
    engines_ok_or_die seam
    report_answer 0 0
    return $CS_EXIT_NO_HITS
  fi
  repos=$(printf '%s\n' "$hits" | cut -d/ -f1 | sort -u)
  n=$(printf '%s\n' "$repos" | grep -c '')
  emit_capped "$hits"
  info ""
  info "${C_BOLD}$n repo(s):${C_OFF} $(printf '%s ' $repos)"

  # The orphan warning is computed on WHOLE-IDENTIFIER matches, even though the
  # hits shown above are substring matches. Showing fewer hits would risk losing
  # a real use (a name assembled by concatenation is exactly the heuristic blind
  # spot documented in `cs why`); computing the warning on the narrower set
  # loses nothing and restores the signal.
  local word_hits word_repos n_word substring_only ww_rc
  word_hits=$(printf '%s\n' "$hits" | whole_word_hits "$1"); ww_rc=$?
  # The orphan warning ASSERTS A NEGATIVE, so it needs the same evidence bar as
  # any other negative here: if the analysis did not run, no warning is emitted
  # at all. Reading a failed helper's empty output as "nothing matched" is what
  # turned a live seam into a dead one.
  if [[ $ww_rc -ne 0 ]]; then
    engine_error "whole-identifier analysis failed (exit $ww_rc) while checking '$1'"
    warn "could not determine whole-identifier matches — the dead/orphan warning is NOT being reported for this query"
    report_answer "$(n_hits_in "$hits")" "$n"
    return 0
  fi
  word_repos=$(printf '%s\n' "$word_hits" | grep '[^[:space:]]' | cut -d/ -f1 | sort -u)
  n_word=$(printf '%s\n' "$word_repos" | grep -c '[^[:space:]]')

  if [[ $n_word -eq 0 ]]; then
    warn "no repo mentions this as a whole identifier — every hit is inside a longer name, so this is a producer with no consumer, or dead"
  elif [[ $n_word -eq 1 ]]; then
    if [[ $n -eq 1 ]]; then
      warn "only one repo mentions this -- a producer with no consumer, or dead"
    else
      warn "only one repo mentions this as a whole identifier ($(printf '%s' "$word_repos")) -- a producer with no consumer, or dead"
    fi
  fi
  # Said whichever way the warning went, in the same spirit as `prose filtered
  # except:`: name what could not be counted so the reader can discount it.
  if [[ $n_word -lt $n ]]; then
    substring_only=$(comm -23 <(printf '%s\n' "$repos" | sort -u) \
                              <(printf '%s\n' "$word_repos" | grep '[^[:space:]]' | sort -u) 2>/dev/null | tr '\n' ' ')
    warn "$((n - n_word)) repo(s) matched only INSIDE a longer identifier: ${substring_only:-?}— not whole-word (use --word to search identifiers only)"
  fi
  report_answer "$(n_hits_in "$hits")" "$n"
}

# Deliberately not a natural-language router: guessing intent from a sentence
# fails quietly and is hard to debug. This prints the decision table instead, so
# the caller picks with the reasoning visible.
cmd_which() {
  cat <<'TABLE'
What do you want to know?                        Use
------------------------------------------------ ----------------------------
Who calls / uses this endpoint, topic, key?      cs uses <string>
Which repos share this string?                   cs seam <string>
Any text or regex, including comments            cs text <pattern>
Where is this symbol defined?                    cs def <symbol> [repo]
What calls look like X, or take literal Y?       cs calls '<pattern>' [lang]
What implements this interface?                  cs impls <symbol> <repo>
What references this symbol (bridges DI)?        cs refs <symbol> <repo> <file>
Which repo publishes this package?               cs provides <coordinate>
Which repos depend on which?                     cs deps [repo]
Which version does each repo pin?                cs versions [coordinate]
Who owns this repo, or this file?                cs owns [repo|repo/path]
When did this seam appear, or last change?       cs history <string> [repo]
What am I actually searching right now?           cs repos
How much should I trust this answer?             cs why [kind]

Two same-named symbols in different repos: resolve the dependency first, then
filter, because code search alone cannot tell them apart:

  cs def DiscountEngine "$(cs provides com.acme:pricing-lib)"

When a consumer breaks and nothing in its own repo changed, the trigger is in
another repo and its history is not reachable from here. cs history spans the
fleet and sorts by date, which puts the two changes side by side:

  cs history '"reservationId"'      # every repo that added or removed it, in order

Start cheap. cs uses and cs def answer most questions in well under a second;
cs impls and cs refs start language servers and are far slower.

Every answer prints the KIND of evidence behind it. Read that before acting on
a negative result: `cs uses` finding nothing is weak evidence of no callers,
because it cannot see a path assembled by concatenation. `cs why` explains.
TABLE
}

# "Who actually uses this string in code?" -- the seam question with prose
# removed. No single engine answered this: text search counts a docstring
# mentioning an endpoint as a caller, and a symbol graph cannot see the string
# literal that is the real call site.
cmd_uses() {
  [[ $# -ge 1 ]] || die "cs uses <string>"
  require_python3 uses "excluding comments and docstrings from the hits"
  local hits repos unsupported unsup_file
  # The filter cannot cover every language, and a hit in one it does not know is
  # passed through unfiltered. Saying "prose filtered" over those anyway is a
  # provenance claim the run did not honour -- the exact overstatement the kind
  # labels exist to prevent -- so the note is built from what actually happened.
  unsup_file="$(mktemp -t cs-unsup.XXXXXX)"
  # Two steps rather than one pipeline. Under pipefail the pipeline's status is
  # whichever stage failed LAST, so ripgrep exiting 2 over an unreadable file
  # was reported as "filter_code.py exited 2" -- blaming a stage that had run
  # perfectly. grep_fleet records its own status internally; what is caught
  # here is filter_code.py actually dying, which empties the stream and leaves
  # `cs uses` reporting a confident zero while still claiming "prose filtered".
  local filter_rc raw_hits
  raw_hits=$(mktemp -t "cs-uses.$$")
  grep_fleet literal "$1" | normalize > "$raw_hits"
  hits=$(python3 "$lib_dir/filter_code.py" --root "$view" --report-unsupported \
         < "$raw_hits" 2>"$unsup_file")
  filter_rc=$?
  unsupported=$(cut -f1 "$unsup_file" | sort -u | tr '\n' ' ' | sed 's/ $//')
  rm -f "$unsup_file"
  # filter_code.py exits 0 on every legitimate outcome, including empty input,
  # so any non-zero here is the filter itself failing.
  [[ "$filter_rc" -ne 0 ]] && engine_error "filter_code.py exited $filter_rc while removing comments from the hits"
  if [[ -n "$unsupported" ]]; then
    answer heuristic "$(text_engine)" "literal, prose filtered except: $unsupported"
  else
    answer heuristic "$(text_engine)" "literal, prose filtered"
  fi
  if [[ -z "$hits" ]]; then
    engines_ok_or_die uses
    info "no code uses '$1'"
    local prose
    # Re-uses the captured hits rather than searching a second time: a repeat
    # grep_fleet would re-report every unreadable file and double the count.
    prose=$(python3 "$lib_dir/filter_code.py" --invert --root "$view" < "$raw_hits" 2>/dev/null)
    if [[ -n "$prose" ]]; then
      warn "mentioned only in comments/docs:"
      # stderr, like every other diagnostic. On stdout these lines landed in the
      # scoreable result stream of a query that had just reported ZERO hits, so
      # a caller piping cs saw comment matches presented as results -- and a
      # decoy planted in a docstring could be scored as a hit against the very
      # answer that correctly excluded it.
      printf '%s\n' "$prose" >&2
    fi
    rm -f "$raw_hits"
    report_answer 0 0
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw_hits"
  [[ -n "$unsupported" ]] && warn "comments were NOT filtered in: $unsupported — hits in those files may be prose (cs why heuristic)"
  # Same reasoning as the seam warning: a hit inside a longer identifier is not
  # a use of THIS name, and "who uses this" is the question being asked. Named
  # rather than removed, so a name genuinely assembled from parts is not lost.
  local uses_word n_uses_word n_uses_all uw_rc
  uses_word=$(printf '%s\n' "$hits" | whole_word_hits "$1"); uw_rc=$?
  n_uses_all=$(n_hits_in "$hits")
  n_uses_word=$(printf '%s\n' "$uses_word" | grep -c '[^[:space:]]')
  if [[ $uw_rc -ne 0 ]]; then
    # Same rule as cs seam: a claim about what did NOT match needs the analysis
    # to have actually run.
    engine_error "whole-identifier analysis failed (exit $uw_rc) while checking '$1'"
    warn "could not determine which hits matched inside a longer identifier"
  elif [[ "$n_uses_word" -lt "$n_uses_all" ]]; then
    warn "$((n_uses_all - n_uses_word)) of $n_uses_all hit(s) matched INSIDE a longer identifier — not a use of this name (use --word to exclude them)"
  fi
  emit_capped "$hits"
  repos=$(printf '%s\n' "$hits" | cut -d/ -f1 | sort -u)
  info ""
  info "${C_BOLD}$(printf '%s\n' "$repos" | grep -c '') repo(s) use it:${C_OFF} $(printf '%s ' $repos)"
  report_answer "$(n_hits_in "$hits")" "$(n_repos_in "$hits")"
}

# The fleet's identity for caching: which repos are in the view and what commit
# each sits on. Reading refs is milliseconds; it is the one cheap thing that
# changes whenever the fleet is refreshed or a ticket branch moves.
# Keyed on the REAL repo paths, never on $view: in a ticket workspace the view
# is a fresh temp directory of symlinks on every invocation, so including it
# would change the key every run and the cache would never hit at all -- which
# is exactly the case where the fleet is large and the saving matters.
#
# The hashing chain is longer than it looks like it needs to be. `md5` lives in
# /sbin on macOS and `md5sum` does not exist there at all, so a trimmed PATH
# finds NEITHER -- and the old `md5 -q || md5sum` chain then produced an EMPTY
# fingerprint rather than failing. The cache path became the constant
# `cs-tags-.tags`, every fleet shared one symbol index, and `cs def` answered
# one fleet's question from another fleet's index. A confident wrong answer, in
# the one command whose entire job is "where is this defined".
#
# Returns non-zero when nothing on this machine can hash, so the caller can skip
# the cache instead of sharing one. Slower is a cost; wrong is a defect.
view_fingerprint() {
  local d data h out
  data=$({ for d in $(real_dirs); do
             printf '%s %s\n' "$d" "$(git -C "$d" rev-parse HEAD 2>/dev/null || echo nogit)"
           done
         } | sort)
  # cksum is POSIX and therefore the backstop: a weak checksum is still a
  # correct cache KEY, because a collision only costs a rebuild.
  for h in "md5 -q" "md5sum" "shasum -a 1" "cksum"; do
    out=$(printf '%s\n' "$data" | $h 2>/dev/null | head -1 | awk '{print $1}')
    [[ -n "$out" ]] && { printf '%s\n' "$out"; return 0; }
  done
  return 1
}

# The cross-repo graph alternative to the ctags index. Unlike ctags -- which
# indexes the whole view in one pass -- graphs are per-repo, so coverage is
# whatever has been indexed. That gap is DISCLOSED rather than assumed away: a
# repo without a graph is a place results cannot come from, which is the same
# hazard as an excluded directory.
def_via_tokensave() {  # <symbol> [only-repo]
  local sym="$1" only="${2:-}" d name out="" rc n_graph=0 no_graph="" oldest="" age
  for d in $(real_dirs); do
    name=$(basename "$d")
    [[ -n "$only" && "$name" != "$only" ]] && continue
    if ! tokensave_graph_at "$d"; then no_graph="$no_graph $name"; continue; fi
    n_graph=$((n_graph + 1))
    age=$(tokensave_graph_age_days "$d") || age=""
    if [[ -n "$age" && ( -z "$oldest" || "$age" -gt "$oldest" ) ]]; then oldest="$age"; fi
    local one
    one=$(python3 "$lib_dir/tokensave_call.py" def "$d" "$name" "$sym"); rc=$?
    [[ $rc -eq 4 ]] && die "cs def: the tokensave graph for $name could not be queried
  nothing was read there, so nothing was ruled out
  check: cs engines   (graph presence and age)"
    [[ -n "$one" ]] && out="${out:+$out
}$one"
  done
  [[ $n_graph -gt 0 ]] || die "cs def: no repo in view has a tokensave graph
  build one with: cd <repo> && tokensave init
  or install universal-ctags, which indexes the whole view in one pass"
  answer structural "tokensave (graph)" "$n_graph repo graph(s), no ctags index"
  [[ -n "$oldest" ]] && warn "answered from graph(s) last synced up to ${oldest} day(s) ago — changes made since are invisible (tokensave sync)"
  # The uncovered repos, named. A symbol defined in one of them looks exactly
  # like a symbol that does not exist.
  [[ -n "$no_graph" ]] && warn "no tokensave graph, so NOT searched:$no_graph — a definition in those repos cannot be found this way"
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs text '$sym'          (the graph indexes declarations, not every spelling)" \
         "cs uses '$sym'          (a cross-repo reference is a string, not a symbol)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_def() {
  [[ $# -ge 1 ]] || die "cs def <symbol> [repo]"
  local only="${2:-}"
  # --engine=tokensave asks for the graph deliberately; otherwise it is the
  # fallback for a machine with no universal-ctags, where cs def had no answer
  # at all rather than a weaker one.
  if [[ "${force_engine:-}" == tokensave ]]; then
    have_tokensave || die "--engine=tokensave requested but tokensave is not installed"
    def_via_tokensave "$1" "$only"
    return $?
  fi
  local ct
  if ! ct=$(ctags_bin); then
    if have_tokensave; then
      local _d
      for _d in $(real_dirs); do
        if tokensave_graph_at "$_d"; then def_via_tokensave "$1" "$only"; return $?; fi
      done
    fi
    die "universal-ctags not installed
  install it: brew install universal-ctags
  or build a tokensave graph, which cs def can read instead:
    cd <repo> && tokensave init"
  fi

  # The index was originally rebuilt on every query, on the grounds that it is
  # cheap and therefore never stale. That held at 0.07s on a five-file fixture
  # and does not hold at scale: measured 5.8s over 456k lines (scripts/
  # bench-scale), which puts a real ten-repo fleet well past the point where
  # anyone would keep using the command.
  #
  # So it is cached, keyed on the repos in view and the commit each is on, with
  # a short TTL as the backstop for uncommitted edits -- which refs cannot see
  # and which are exactly what you have while working a ticket. The staleness
  # window is bounded and stated rather than hidden; --refresh forces a rebuild.
  local fp tags age ttl="${CS_TAGS_TTL:-60}" cached="" no_cache=0
  if fp=$(view_fingerprint); then
    tags="${TMPDIR:-/tmp}/cs-tags-${fp}.tags"
  else
    # Nothing here can hash, so there is no key that distinguishes this fleet
    # from another. Build a private index and throw it away rather than write to
    # a shared path that would answer the next fleet's question with this one's.
    no_cache=1
    tags="${TMPDIR:-/tmp}/cs-tags-nokey.$$.tags"
    warn "no md5/shasum/cksum on PATH — the symbol index cannot be cached safely, so it is rebuilt for this query"
  fi

  if [[ $no_cache -eq 0 && $refresh_index -eq 0 && -s "$tags" ]]; then
    age=$(( $(date +%s) - $(file_mtime "$tags") ))
    if [[ $age -ge 0 && $age -lt $ttl ]]; then cached="cached ${age}s ago"; fi
  fi

  # Built to a private path and moved into place, never written where a reader
  # can see it half-finished. The cache path is shared by construction -- it is
  # keyed on the fleet, so every concurrent `cs def` computes the SAME name --
  # and agents issue tool calls in parallel by default. Writing $tags directly
  # meant six simultaneous runs returned: three answers and three empty results,
  # each labelled a normal `structural via ctags` answer. A false negative
  # produced by nothing worse than being asked two questions at once.
  #
  # rename(2) is atomic within a filesystem, so a reader sees either the old
  # complete index or the new one. Whoever finishes last wins, and since every
  # writer is building the same content from the same fingerprint, that is fine.
  if [[ -z "$cached" ]]; then
    # The key includes each repo's commit, so every fleet refresh or branch
    # switch strands the previous index. On a large fleet these are tens of MB
    # each and nothing ever removed them. Swept on rebuild, which is the only
    # moment a new one is created; -mmin +1440 keeps today's other checkouts.
    find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'cs-tags-*.tags' -mmin +1440 -delete 2>/dev/null
    local tmp_tags="$tags.$$.building"
    run_timed "$ct" -R --links=yes --fields=+n -f "$tmp_tags" "$view"/*/ 2>/dev/null
    # A ctags run that fails PARTWAY leaves a non-empty index covering some of
    # the fleet, which the -s check below happily accepts -- so a symbol in an
    # unindexed repo comes back "not defined anywhere" with a normal structural
    # label. Total failure was already caught; partial failure was not.
    note_run_status $? ctags "building the fleet symbol index"
    if [[ ! -s "$tmp_tags" ]]; then
      rm -f "$tmp_tags"
      die "ctags produced no index under $root"
    fi
    mv -f "$tmp_tags" "$tags" 2>/dev/null || { rm -f "$tmp_tags"; die "could not install the symbol index at $tags"; }
    answer structural "ctags" "fleet-wide symbol index, rebuilt now"
  else
    answer structural "ctags" "fleet-wide symbol index, $cached — uncommitted edits within ${ttl}s may be missing (--refresh)"
  fi
  # A concurrent --refresh can replace the file between the check above and the
  # read below; both are complete indexes, so re-checking is enough.
  if [[ ! -s "$tags" ]]; then die "the symbol index at $tags vanished or is empty"; fi
  # Per-process, because the result file was previously shared too: one run
  # deleted $tags.out while another was still reading it, which is the other
  # half of the same empty-answer bug.
  local out
  out=$(awk -F'\t' -v want="$1" '$1 == want {
      line = "?"; kind = "?";
      for (i = 4; i <= NF; i++) {
        if ($i ~ /^line:/) { line = substr($i, 6) }
        else if (length($i) <= 2) { kind = $i }
      }
      printf "%s:%s: [%s] %s\n", $2, line, kind, want
  }' "$tags" | normalize | sort -u | { if [[ -n "$only" ]]; then grep "^$only/" || true; else cat; fi; })
  if [[ -z "$out" ]]; then
    engines_ok_or_die def
    report_answer 0 0
    hint "cs text '$1'           (ctags misses symbols built dynamically)" \
         "cs refs $1 <repo> <file>  (for a precise, LSP-backed answer)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  # Two repos defining the same name is the failure mode this cannot resolve:
  # ctags matches spelling, so it cannot tell you which one your caller means.
  local nr; nr=$(n_repos_in "$out")
  [[ $nr -gt 1 ]] && warn "defined in $nr repos — same name, possibly unrelated types. Resolve with: cs def $1 \"\$(cs provides <coordinate>)\""
  report_answer "$(n_hits_in "$out")" "$nr"
}

# Which repo publishes a coordinate, and which repos depend on which. Answers
# the one question code search structurally cannot: choosing between two
# same-named symbols requires knowing which repo the caller actually depends
# on, and that lives in build manifests, not in code.
# The manifest readers all pipe through one python3 module, and none of them
# looked at whether it succeeded. A crash in deps.py made `cs provides` and
# `cs versions` report a confident zero, and made `cs deps` and `cs publishes`
# exit 0 with no output at all -- the worst of the set, because exit 0 is the
# code that means "the query ran and found something".
#
# deps.py and owners.py already draw the same distinction cs does -- 0 found
# something, 1 ran and found nothing, >=2 failed -- so only >=2 is an error
# here. Treating every non-zero as a failure turns a legitimate "no repo
# publishes this" into a refusal, which is the mirror image of the bug being
# fixed and just as wrong: it makes an honest negative undetectable.
manifest_ok_or_die() {  # <rc> <subcommand> <module> <what it was reading>
  [[ "${1:-0}" -le 1 ]] && return 0
  die "cs $2: $3 failed (exited $1), so nothing was read
  it was $4, and no manifest was parsed — this is not 'nothing is declared'
  check: cs repos   (are the repos in view the ones you expect?)"
}

cmd_provides() {
  [[ $# -ge 1 ]] || die "cs provides <coordinate>"
  require_python3 provides "reading the build manifests that declare it"
  answer declared "build manifests" "publish declarations"
  local out rc; out=$(python3 "$lib_dir/deps.py" "$view" provides "$1"); rc=$?
  manifest_ok_or_die "$rc" provides deps.py "looking for what publishes '$1'"
  # A bare `printf '%s\n' ""` emits a blank line, which reads as an answer and
  # is what `cs def X "$(cs provides …)"` silently turns into "every repo".
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs publishes           (what every repo declares that it publishes)" \
         "cs seam '$1'           (the coordinate may be referenced but not declared here)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  report_answer
}

# The outlier of the declared family: it neither validated its repo argument nor
# followed the zero-hit contract, so `cs deps <real-repo-with-no-edges>` and
# `cs deps <repo-that-does-not-exist>` were byte-identical -- exit 0, a single
# blank line, no count, no message. A typo in a repo name was answered as "no
# dependencies", which is a manufactured negative of exactly the kind the rest
# of this tool refuses to produce. `cs provides` is the same code path one
# function over and gets every part of this right.
cmd_deps() {
  require_python3 deps "reading the build manifests the graph is built from"
  local only="${1:-}"
  # `cs impls` proves the check is cheap and already written elsewhere.
  if [[ -n "$only" ]]; then
    if [[ ! -d "$view/$only" ]] || ! is_repo "$view/$only"; then
      die "no such repo: $only
  answering 'no dependencies' for a name that is not a repo would be a
  manufactured negative, so this refuses instead
  cs repos   lists the repositories actually in view"
    fi
  fi
  answer declared "build manifests" "dependency declarations"
  local out rc; out=$(python3 "$lib_dir/deps.py" "$view" deps "$only"); rc=$?
  manifest_ok_or_die "$rc" deps deps.py "building the fleet dependency graph"
  if [[ -z "$out" ]]; then
    # An empty dependency graph is a substantive claim, not silence: a fleet can
    # genuinely have no intra-fleet edges while every repo publishes something.
    # Said with a count and a code, like every other subcommand.
    report_answer 0 0
    hint "cs publishes           (what each repo declares it publishes)" \
         "cs versions            (which coordinates the fleet shares at all)" \
         "cs provides <coord>    (whether a specific coordinate is published here)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # Edges, and the repos they span: the row is `consumer -> producer (coord)`.
  report_answer "$(n_hits_in "$out")" \
                "$(printf '%s\n' "$out" | cut -f1,3 | tr '\t' '\n' | sort -u | grep -c '[^[:space:]]')"
}

cmd_publishes() {
  require_python3 publishes "reading the build manifests the graph is built from"
  answer declared "build manifests" "publish declarations"
  local out rc; out=$(python3 "$lib_dir/deps.py" "$view" publishes); rc=$?
  manifest_ok_or_die "$rc" publishes deps.py "reading what each repo publishes"
  emit_plain "$out"
  report_answer
}

# "Is the fleet agreed on a version of this?" -- `cs deps` deliberately drops
# versions, because "who depends on what" does not need them. This is the other
# question, and it is the one that finds a repo left behind by an upgrade: a
# shared contract library at two versions across a seam is a real bug shape,
# and it is invisible to every search engine here because the evidence is in
# manifests rather than in code.
cmd_versions() {
  require_python3 versions "reading the version each build manifest pins"
  answer declared "build manifests" "${1:+$1, }version declarations"
  local out rc err_file
  err_file=$(mktemp -t cs-versions.XXXXXX)
  out=$(python3 "$lib_dir/deps.py" "$view" versions "${1:-}" 2>"$err_file"); rc=$?
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  rm -f "$err_file"
  manifest_ok_or_die "$rc" versions deps.py "reading the version each manifest pins"
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs deps               (the coordinate may be spelled differently in the manifest)" \
         "cs provides '${1:-<coordinate>}'   (confirm a fleet repo publishes it at all)" \
         "cs versions           (with no argument: every coordinate the fleet declares)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # DRIFT is the finding; say so rather than leaving it in the table. A version
  # spread the caller did not notice is the same class of miss as a caller in a
  # repo they did not search.
  local drift
  drift=$(printf '%s\n' "$out" | grep -c '	DRIFT	' || true)
  [[ "$drift" -gt 0 ]] && warn "$drift coordinate(s) declared at more than one version — see DRIFT above"
  report_answer
}

# Who to ask about a result. Every other subcommand answers WHERE something is,
# and the next question is always who owns it -- which in a single repo is a
# `cat CODEOWNERS` away and across a fleet is not, because the file lives in a
# repo you have never opened.
cmd_owns() {
  require_python3 owns "parsing CODEOWNERS and matching its patterns"
  local mode="file" arg="${1:-}"
  if [[ -z "$arg" ]]; then
    mode="audit"
  elif [[ "$arg" != */* ]]; then
    # A bare name is a repo, a name with a slash is a path inside one.
    mode="repo"
  fi
  answer declared "CODEOWNERS" "$mode"
  # Captured separately, not with 2>&1. owners.py writes the GAPS to stderr on
  # purpose -- a repo with no CODEOWNERS is a finding, not an owner -- and
  # merging the streams put "no CODEOWNERS" on stdout as though it answered the
  # question. stdout is the result stream; that is a contract, not a preference.
  local out rc err_file
  err_file=$(mktemp -t cs-owns.XXXXXX)
  out=$(python3 "$lib_dir/owners.py" "$view" "$mode" ${arg:+"$arg"} 2>"$err_file"); rc=$?
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  rm -f "$err_file"
  # The two halves used to share one branch and one exit code. owners.py failing
  # is a REFUSAL -- the CODEOWNERS files were never read, so no rule was ruled
  # out -- while owners.py succeeding with no rows is an honest "nothing names
  # this". Collapsing them is the same mistake as collapsing a missing fleet
  # root into "nothing found".
  # >=2 only. owners.py returns 1 for "ran, and no rule matched", which is a
  # real answer -- the last release treated it as a failure and refused, so
  # `cs owns` on a path no CODEOWNERS rule covers stopped being answerable.
  if [[ $rc -ge 2 ]]; then
    die "cs owns: could not read CODEOWNERS across the fleet (owners.py exited $rc)
  nothing was parsed, so this is not 'nobody owns it'
  check: cs repos (is the view what you expect?)"
  fi
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs owns               (which repos declare ownership at all)" \
         "cs owns <repo>        (every rule in one repo)" \
         "cs repos              (the exact repo names in view)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # Stated every time, because a CODEOWNERS answer is the one most likely to be
  # repeated to a person as fact. It says who the file names, which is not the
  # same as who will review the change or who understands the code.
  warn "CODEOWNERS is a declaration, not a fact about who knows this code — it can name a team that no longer exists, and it says nothing about repos with no file at all"
  report_answer
}

# The facade's own hazard: this falls back ast-grep -> semgrep, so an engine can
# break while every scored query still passes. The fallback is therefore
# announced rather than silent, and --engine= makes it fail instead.
cmd_calls() {
  [[ $# -ge 1 ]] || die "cs calls <pattern> [lang]"
  local pattern="$1" lang="${2:-}" out engine="${force_engine:-}"
  if [[ -z "$engine" ]]; then
    if have ast-grep; then engine=ast-grep
    elif have semgrep; then engine=semgrep; CS_DEGRADED="ast-grep absent, fell back to semgrep (different pattern dialect, different results)"
    else die "neither ast-grep nor semgrep installed"
    fi
  else
    have "$engine" || die "--engine=$engine requested but not installed"
  fi
  answer structural "$engine" "${lang:-all languages}"

  case "$engine" in
    ast-grep)
      local args=(--follow -p "$pattern")
      [[ -n "$lang" ]] && args+=(-l "$lang")
      local ag_raw ag_rc ag_err
      ag_err=$(mktemp -t "cs-engerr.$$")
      ag_raw=$( (cd "$view" && run_timed ast-grep "${args[@]}") 2>"$ag_err" ); ag_rc=$?
      # ast-grep follows the grep convention, so an unparseable pattern or an
      # unknown language is >=2 and distinguishable from an honest no-match --
      # and, like ripgrep, it reports an unreadable file the same way, which is
      # a skipped file rather than a broken engine.
      note_search_result "$ag_rc" "$ag_err" ast-grep "matching '$pattern'${lang:+ in $lang}"
      rm -f "$ag_err"
      out=$(printf '%s\n' "$ag_raw" | normalize) ;;
    semgrep)
      # semgrep does not follow symlinks, so it is pointed at the real paths.
      local args=(-e "$pattern" --quiet --no-git-ignore)
      [[ -n "$lang" ]] && args+=(-l "$lang")
      # semgrep exits 0 whether or not it matched, so any non-zero is an error.
      # Recorded per repo inside the loop, because the loop's own status is only
      # that of the last repo and a failure on the first would vanish.
      local d
      out=$(while IFS= read -r d; do
              [[ -n "$d" ]] || continue
              (cd "$(dirname "$d")" && run_timed semgrep "${args[@]}" "$(basename "$d")" 2>/dev/null)
              note_run_status $? semgrep "matching '$pattern' in $(basename "$d")"
            done < <(real_dirs) | normalize) ;;
    *) die "unknown structural engine: $engine" ;;
  esac

  if [[ -z "$out" ]]; then
    engines_ok_or_die calls
    report_answer 0 0
    # A structural engine returns nothing both when there is no match and when
    # it cannot parse the language at all. Those are very different, and the
    # caller cannot tell them apart from an empty result.
    hint "cs text '$pattern'     (a structural engine returns nothing for a language it cannot parse — same as no match)" \
         "cs calls '$pattern' <lang>   (naming the language makes an unsupported one an error rather than silence)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# The second layer of the same guard as require_serena_toolchain, and the one
# that does not depend on knowing the language: never label `resolved` a
# zero-hit result the engine did not AFFIRMATIVELY produce.
#
# `answer resolved` used to be set before the call and survived every outcome --
# a server that errored, a call that timed out, a project that failed to load.
# All three arrived at the same `report_answer 0 0` as a genuine "no references
# exist", and only the genuine case is a negative result at all. The others are
# the absence of an answer, and the distinction is invisible from the empty
# string a single `out=$(… | …)` pipeline leaves behind.
#
# Called only when the formatted output is empty, so a partial-but-non-empty
# result still reaches the caller with its PARTIAL warning attached.
serena_answered_or_die() {  # <rc> <raw-file> <stderr-file> <subcommand> <symbol> <repo>
  local rc="$1" raw="$2" ef="$3" sub="$4" sym="$5" repo="$6" detail
  detail=$(head -3 "$ef" 2>/dev/null | tr '\n' ' ')
  # Checked before the exit status, because a timeout is the more specific
  # diagnosis and run_timed reports it as a non-zero rc of its own.
  if timed_out; then
    die "cs $sub: the language server hit the ${CS_TIMEOUT:-120}s timeout on '$sym' in $repo — PARTIAL, not an answer
  it did not finish, so there is nothing here to call a negative; a 'resolved'
  label on an unfinished run would be the strongest claim on the weakest evidence
  raise CS_TIMEOUT and rerun, or fall back to: cs def $sym $repo"
  fi
  if [[ "$rc" -ne 0 ]]; then
    die "cs $sub: the language server did not answer for '$sym' in $repo (serena exited $rc)
  ${detail:-no diagnostic was produced}
  nothing was analysed, so this is NOT 'resolved · 0 hit(s)' — nothing was ruled out
  check: cs engines   (is this language's toolchain installed and runnable?)
  weaker but available now: cs def $sym $repo, cs uses '$sym'"
  fi
  if [[ ! -s "$raw" ]]; then
    die "cs $sub: the language server exited cleanly but returned no content for '$sym' in $repo
  an empty response is not an empty result set — the project may have failed to load
  check: cs engines   (per-kind availability, including the language toolchains)
  weaker but available now: cs def $sym $repo, cs uses '$sym'"
  fi
  return 0
}

# The LSP-backed answers are the only ones that resolve an interface to its
# implementation, so they are worth the setup cost -- but only these.
# The graph route, taken only when the language server cannot run. Answers are
# `structural`, never `resolved`.
impls_via_tokensave() {  # <symbol> <repo-name> <repo-dir> <missing-toolchain>
  local sym="$1" repo="$2" dir="$3" tc="$4" out rc age
  answer structural "tokensave (graph)" "scoped to $repo; no $tc here, so no language server"
  out=$(python3 "$lib_dir/tokensave_call.py" impls "$dir" "$repo" "$sym"); rc=$?
  case "$rc" in
    3) die "cs impls: '$sym' is not a type in $repo's graph
  the graph was never asked the question, so this is not 'nothing implements it'
  the graph may also predate the symbol — rebuild with: cd $dir && tokensave sync
  weaker but available now: cs def $sym $repo, cs uses '$sym'" ;;
    4) die "cs impls: the tokensave graph could not be queried for '$sym' in $repo
  nothing was read, so nothing was ruled out
  check: cs engines   (graph presence and age)" ;;
  esac
  # A graph answers about the code as of its last sync, which makes staleness a
  # correctness problem rather than a tidiness one. Always stated.
  age=$(tokensave_graph_age_days "$dir") && [[ -n "$age" ]] && \
    warn "answered from a tokensave graph last synced ${age} day(s) ago — it cannot see changes made since (cd $dir && tokensave sync)"
  warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, or generated code. cs refs is the only thing here that bridges a DI registration, and it needs $tc."
  if [[ $rc -ne 0 || -z "$out" ]]; then
    report_answer 0 0
    hint "cs def $sym $repo       (where the symbol is declared)" \
         "cs calls '<pattern>'    (a shape the graph did not record)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_impls() {
  [[ $# -ge 2 ]] || die "cs impls <symbol> <repo> [file]"
  require_python3 impls "driving the language server and formatting its answer"
  local repo_dir="$view/$2" file="${3:-}"
  [[ -d "$repo_dir" ]] || die "no such repo: $2"
  # Routing, in order of answer strength: a language server when it can run, a
  # graph when it cannot, and a refusal only when neither is available.
  local _missing_tc
  if _missing_tc=$(serena_missing_toolchain "$repo_dir"); then
    if have_tokensave && tokensave_graph_at "$repo_dir"; then
      impls_via_tokensave "$1" "$2" "$repo_dir" "$_missing_tc"
      return $?
    fi
  fi
  have uvx || die "serena needs uv installed"
  require_serena_toolchain impls "$1" "$2" "$repo_dir"

  # Serena identifies a symbol by name_path plus the file holding it, so the
  # symbol is looked up first rather than assuming a bare name is enough.
  local resolved
  resolved=$(python3 "$lib_dir/serena_call.py" "$repo_dir" find_symbol \
             "{\"name_path\":\"$1\",\"include_body\":false}" 2>/dev/null \
    | python3 -c '
import json, sys
raw = sys.stdin.read().strip()
try:
    rows = json.loads(raw) if raw else []
except json.JSONDecodeError:
    rows = []
want = sys.argv[1]
pick = next((r for r in rows if r.get("kind") not in ("File",)
             and r.get("name_path", "").split("/")[-1] == want), None)
if pick:
    print(pick["name_path"] + "\t" + pick["relative_path"])
' "$1")

  local name_path rel
  name_path=$(printf '%s' "$resolved" | cut -f1)
  rel=$(printf '%s' "$resolved" | cut -f2)
  [[ -n "$file" ]] && rel="$file"
  # A REFUSAL, not a zero-hit answer: find_implementations was never called, so
  # no implementation was ruled out. It reported the same exit code as a real
  # empty result set, which is the distinction this whole taxonomy turns on.
  if [[ -z "$name_path" || -z "$rel" ]]; then
    err "could not locate symbol '$1' in $2 — find_implementations was not run, so nothing was ruled out"
    hint "cs def $1 $2            (check the symbol exists and how it is spelled)"
    return $CS_EXIT_REFUSED
  fi

  # Run as two steps rather than one pipeline, because the pipeline collapsed
  # exactly the two outcomes that must never be confused: a server that produced
  # no answer, and a server that answered "none". Both left "$out" empty.
  #
  # Formatted and capped like every other subcommand. Raw Serena JSON was both
  # unscoreable and uncapped, so the one engine whose answers are strongest was
  # also the one whose output could flood a context window unannounced.
  local out raw err_file rc
  raw=$(mktemp -t "cs-serena.$$"); err_file=$(mktemp -t "cs-serena-err.$$")
  run_timed python3 "$lib_dir/serena_call.py" "$repo_dir" find_implementations \
        "{\"name_path\":\"$name_path\",\"relative_path\":\"$rel\"}" \
        >"$raw" 2>"$err_file"; rc=$?
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  out=$(python3 "$lib_dir/serena_fmt.py" "$2" < "$raw")
  if [[ -z "$out" ]]; then
    # Dies unless the emptiness is an answer rather than the absence of one.
    serena_answered_or_die "$rc" "$raw" "$err_file" impls "$1" "$2"
    rm -f "$raw" "$err_file"
    answer resolved "serena (LSP)" "scoped to $2"
    report_answer 0 0
    hint "cs def $1              (confirm the symbol is spelled as the server sees it)" \
         "cs calls '<pattern>'   (an implementation the server could not load is invisible here)"
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw" "$err_file"
  # Set only now, once the server has affirmatively produced something. The
  # label used to be assigned before the call and survived every failure.
  answer resolved "serena (LSP)" "scoped to $2"
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_refs() {
  [[ $# -ge 3 ]] || die "cs refs <symbol> <repo> <file-relative-to-repo>"
  have uvx || die "serena needs uv installed"
  require_python3 refs "driving the language server and formatting its answer"
  local repo_dir="$view/$2"
  [[ -d "$repo_dir" ]] || die "no such repo: $2"
  # Before `answer resolved` is set, and before the server is started: uvx,
  # python3 and the repo directory all passing says nothing about whether this
  # language can be loaded at all.
  require_serena_toolchain refs "$1" "$2" "$repo_dir"
  local out raw err_file rc
  raw=$(mktemp -t "cs-serena.$$"); err_file=$(mktemp -t "cs-serena-err.$$")
  run_timed python3 "$lib_dir/serena_call.py" "$repo_dir" find_referencing_symbols \
        "{\"name_path\":\"$1\",\"relative_path\":\"$3\"}" \
        >"$raw" 2>"$err_file"; rc=$?
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  out=$(python3 "$lib_dir/serena_fmt.py" "$2" < "$raw")
  if [[ -z "$out" ]]; then
    serena_answered_or_die "$rc" "$raw" "$err_file" refs "$1" "$2"
    rm -f "$raw" "$err_file"
    answer resolved "serena (LSP)" "scoped to $2"
    report_answer 0 0
    hint "cs def $1 $2            (confirm the symbol and file are right)" \
         "cs uses '$1'           (a reference across a repo boundary is a string, not a symbol)"
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw" "$err_file"
  answer resolved "serena (LSP)" "scoped to $2"
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- history ---------------------------------------------------------------
# The question no search engine answers: not "where is this string" but "when
# did it get there, and what else changed with it". `git log -S` (the pickaxe)
# finds commits that changed the NUMBER of occurrences of a string, which is
# how you find the commit that introduced or removed a seam rather than the
# commits that merely touched the file.
#
# This is the cross-repo case done properly. When a consumer breaks because a
# producer changed, the producer's commit is in a different repo and is not
# reachable from the consumer's history at all -- so the search has to span the
# fleet, ordered by date, to put the two changes next to each other.
cmd_history() {
  [[ $# -ge 1 ]] || die "cs history <string> [repo]"
  local want="$1" only="${2:-}" rows=""

  # -S is the pickaxe: commits where the NUMBER of occurrences changed, which
  # isolates introduction and removal from the noise of commits that merely
  # touched the file. Its blind spot is a change in place -- rewriting the line
  # around the string leaves the count identical, so -S says nothing happened.
  # That is exactly the shape of a serializer or format change, so an empty -S
  # result escalates to -G (any diff hunk matching) rather than reporting none.
  _history_scan() {  # _history_scan <git-flag>
    local flag="$1" d name log out=""
    while IFS= read -r d; do
      [[ -n "$d" && -d "$d/.git" ]] || continue
      name=$(basename "$d")
      [[ -n "$only" && "$name" != "$only" ]] && continue
      # `|| continue` swallowed every git failure, so a repo git could not read
      # -- a corrupt object store, a missing binary, an unreadable ref -- was
      # indistinguishable from a repo with no matching commits. git exits 0
      # whether or not the pickaxe matched, so non-zero is always a real error.
      log=$(run_timed git -C "$d" log --all --no-merges "$flag$want" \
              --pretty=format:'%cs%x09%h%x09%an%x09%s' -- . 2>/dev/null)
      note_run_status $? git "reading history of $name"
      [[ -n "$log" ]] || continue
      out+=$(printf '%s\n' "$log" | sed "s|^|$name\t|")$'\n'
    done < <(real_dirs)
    printf '%s' "$out"
  }

  if [[ $touched_mode -eq 1 ]]; then
    answer historical "git log -G" "any diff hunk mentioning it"
    rows=$(_history_scan -G)
  else
    answer historical "git log -S" "occurrence count changed"
    rows=$(_history_scan -S)
    if [[ -z "$rows" ]]; then
      rows=$(_history_scan -G)
      [[ -n "$rows" ]] && {
        answer historical "git log -G" "no commit changed the count; showing commits that touched it"
        CS_DEGRADED="'$want' was never added or removed as a whole — every hit below modified a line already containing it"
      }
    fi
  fi

  if [[ -z "$rows" ]]; then
    engines_ok_or_die history
    info "no commit in the view added, removed, or modified a line containing '$want'"
    report_answer 0 0
    hint "cs seam '$want'        (confirm any repo contains it at all)" \
         "cs history '<shorter substring>'   (a reformat can hide the original spelling)"
    return $CS_EXIT_NO_HITS
  fi
  # Sorted by date across every repo, because the point is the interleaving:
  # a producer's change landing days before a consumer's incident is the signal.
  emit_plain "$(printf '%s' "$rows" | sort -t$'\t' -k2,2 \
    | awk -F'\t' '{ printf "%s  %-28s %-9s %-18s %s\n", $2, $1, $3, substr($4,1,18), $5 }')"
  report_answer "$(printf '%s' "$rows" | grep -c '')" \
                "$(printf '%s' "$rows" | cut -f1 | sort -u | grep -c '')"
}

# What is actually being searched, and whether each repo came from the ticket or
# the fleet. An agent that cannot see the view cannot judge a negative result.
cmd_repos() {
  local d name target kind n=0
  printf '%-32s %-8s %s\n' "REPO" "LAYER" "PATH"
  for d in "$view"/*; do
    [[ -e "$d" ]] || continue
    if [[ -L "$d" ]]; then target=$(readlink "$d"); else target="$d"; fi
    # When a ticket is layered the view holds only repos already, but an
    # unlayered view IS the fleet root, files and all.
    is_repo "$target" || continue
    name=$(basename "$d")
    if [[ -n "$ticket_root" && "$target" == "$ticket_root"/* ]]; then kind="ticket"; else kind="fleet"; fi
    printf '%-32s %-8s %s\n' "$name" "$kind" "$target"
    n=$((n + 1))
  done
  printf '\n%s repositor%s\n' "$n" "$([[ $n -eq 1 ]] && echo y || echo ies)"
  # Named, so a repo missing because it was never cloned is distinguishable
  # from one missing because cs did not consider it a repo at all.
  local skipped_entries
  skipped_entries=$(non_repo_entries | tr '\n' ' ' | sed 's/ $//')
  [[ -n "$skipped_entries" ]] && warn "not repositories, so not searched: $skipped_entries"
  return 0
}

cmd_why() {
  if [[ $# -ge 1 ]]; then
    blind_spots "$1" || die "unknown answer kind: $1 (resolved, declared, structural, historical, heuristic, textual)"
    # The blind spots above are what the kind cannot see IN PRINCIPLE. Whether
    # you can get an answer of this kind AT ALL on this machine is a different
    # question with the same consequence, and it was only answerable by reading
    # `cs engines` and knowing the routing table by heart.
    local row state detail
    row=$(kind_status "$1")
    state="${row%%|*}"; detail="${row#*|}"
    [[ "$state" == ok ]] || state=$(printf '%s' "$state" | tr 'a-z' 'A-Z')
    printf '\nOn this machine: %s is %s — %s\n' "$1" "$state" "$detail"
    printf 'Backs: %s\n' "$(kind_subcommands "$1")"
    return 0
  fi
  cat <<'TABLE'
Every cs answer is labelled with the kind of evidence behind it. The kind is
what decides how much a NEGATIVE result is worth -- "cs uses found nothing" is
weak evidence of no callers; "cs refs found nothing" is strong.

KIND        WEIGHT  PRODUCED BY                    A NEGATIVE MEANS
----------- ------- ------------------------------ ----------------------------
resolved    highest serena (LSP)                   strong: no reference, in that repo
declared    high    build manifests                strong: not declared
structural  medium  ast-grep / semgrep / ctags     medium: no such shape
historical  high    git log -S                     strong, for tracked files
heuristic   low     text match, prose filtered     weak
textual     lowest  ripgrep / grep                 weak

Run `cs why <kind>` for what that kind specifically cannot see.

EXIT CODES -- a refusal and a zero-hit answer are opposite facts, so they are
different numbers. Branch on the code rather than reading the message:

  0   the query ran and found at least one hit
  1   REFUSAL -- the query did not run, or an engine failed part-way. Nothing
      was searched to completion, so nothing was ruled out. Fix the cause; do
      not fall back to grep.
  2   the query ran honestly and found nothing. Weigh it by the kind above.

A broken engine refuses rather than reporting 0 hits: ripgrep exiting 2, a
regex that does not compile, or a crashing helper all produce empty output that
is otherwise identical to an honest negative.

--porcelain (or CS_JSON=1) puts one JSON object on stdout carrying all of the
above -- kind, engine, hits, repos, degraded, partial, truncated, engine_errors
and the results themselves -- including on a refusal, which has no result
stream to attach anything to. stderr is unchanged either way.

TABLE
  # Which kinds are reachable here, not only what each cannot see. A kind whose
  # every backing engine is missing produces no answers at all, and that was
  # visible nowhere.
  print_kinds_table
}

fleet_only=0
show_why=0
quiet=0
word_match=0
# Env as well as a flag: a caller wrapping cs in a script it does not control
# can set CS_JSON=1 once rather than threading a flag through every call site.
case "${CS_JSON:-0}" in 1|true|yes) porcelain=1 ;; esac
touched_mode=0
refresh_index=0
force_engine=""
CS_MAX_RESULTS="${CS_MAX_RESULTS:-200}"
args=()
for a in "$@"; do
  case "$a" in
    --fleet) fleet_only=1 ;;
    --ticket=*) ticket_id="${a#--ticket=}"
                [[ -n "$ticket_id" ]] || die "--ticket= needs a workspace id, e.g. --ticket=PROJ-123" ;;
    --why) show_why=1 ;;
    --quiet|-q) quiet=1 ;;
    --all) CS_MAX_RESULTS=0 ;;
    --touched) touched_mode=1 ;;
    --engine=*) force_engine="${a#--engine=}" ;;
    --refresh) refresh_index=1 ;;
    --porcelain|--json) porcelain=1 ;;
    --word|-w) word_match=1 ;;
    *) args+=("$a") ;;
  esac
done
# --engine names a text backend as well as a structural one; the text side is
# read from the environment so grep_fleet stays free of the flag plumbing.
case "$force_engine" in
  rg|ripgrep|grep|posix) export CS_TEXT_ENGINE="$force_engine"; force_engine="" ;;
esac
set -- "${args[@]:-}"

[[ $# -ge 1 && -n "${1:-}" ]] || usage 1
sub="$1"; shift
CS_SUB="$sub"; CS_QUERY="${1:-}"
# Everything that reads the fleet must have one; the four that only explain the
# tool must not require it, or the setup you are trying to diagnose blocks the
# diagnosis. `cs engines` is deliberately in the exempt list and prints the root
# it would have used.
case "$sub" in
  which|why|-h|--help|help) ;;
  engines) [[ -d "$root" ]] || warn "fleet root does not exist yet: $root" ;;
  *) require_fleet ;;
esac
build_view
case "$sub" in engines|which|why|repos|-h|--help|help) ;; *) announce_view ;; esac
case "$sub" in
  text)    cmd_text "$@" ;;
  seam)    cmd_seam "$@" ;;
  uses)    cmd_uses "$@" ;;
  def)     cmd_def "$@" ;;
  provides) cmd_provides "$@" ;;
  deps)    cmd_deps "$@" ;;
  publishes) cmd_publishes ;;
  versions) cmd_versions "$@" ;;
  owns)    cmd_owns "$@" ;;
  calls)   cmd_calls "$@" ;;
  impls)   cmd_impls "$@" ;;
  refs)    cmd_refs "$@" ;;
  history) cmd_history "$@" ;;
  repos)   cmd_repos ;;
  which)   cmd_which ;;
  why)     cmd_why "$@" ;;
  engines) cmd_engines ;;
  -h|--help|help) usage 0 ;;
  *) err "unknown subcommand: $sub"; usage 1 ;;
esac
