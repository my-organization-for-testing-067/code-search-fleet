#!/usr/bin/env bash
# Run every scored query through `cs` and report the score.
#
# This is the regression test for the search setup. Run it after changing an
# engine, upgrading a tool, or adopting this on a new machine -- a search stack
# that has quietly lost an engine still returns results, just worse ones, which
# is exactly the failure that goes unnoticed.
#
# Builds its own throwaway fixture fleet unless you deliberately point
# FLEET_ROOT at one in the environment.
#
# Usage: verify-search [--keep]
set -uo pipefail

# Captured BEFORE common.sh, which fills FLEET_ROOT in from ~/.config/repo-fleet
# or a built-in default. Only an explicit environment value means "score against
# this fleet instead of the fixture" -- a configured root is just where the user
# happens to work, and scoring the suite against it silently reports failures
# that are not real. Reading $FLEET_ROOT after sourcing cannot tell the two
# apart, which is what happened the day cs started honouring the config file.
_explicit_fleet_root="${FLEET_ROOT:-}"

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root_dir="$(cd "$here/.." && pwd)"
keep=0
[[ "${1:-}" == "--keep" ]] && keep=1

owned_fleet=0
# An explicit root still has to hold repos; an empty directory would score every
# query as "nothing found" and report a broken search stack.
if [[ -n "$_explicit_fleet_root" ]] && ! compgen -G "$_explicit_fleet_root/*/.git" >/dev/null; then
  warn "FLEET_ROOT is set but holds no repositories: $_explicit_fleet_root"
  warn "using a throwaway fixture fleet instead"
  _explicit_fleet_root=""
fi
FLEET_ROOT="$_explicit_fleet_root"
if [[ -z "$FLEET_ROOT" || ! -d "$FLEET_ROOT" ]]; then
  FLEET_ROOT="$(mktemp -d)/fleet"
  export FLEET_ROOT
  owned_fleet=1
  info "building a throwaway fixture fleet…"
  "$here/build-fixtures" "$FLEET_ROOT" >/dev/null 2>&1 || die "could not build fixtures"
fi

info "${C_BOLD}fleet:${C_OFF} $FLEET_ROOT"
info ""

pass=0; fail=0; failed_ids=()

check() {
  local id="$1"; shift
  local out
  out=$("$@" 2>/dev/null)
  if printf '%s\n' "$out" | "$here/score-seams" "$id" - >/dev/null 2>&1; then
    ok "$id"; pass=$((pass + 1))
  else
    err "$id"; fail=$((fail + 1)); failed_ids+=("$id")
  fi
}

check reserve-consumers       "$here/cs" uses '/api/v1/inventory/reserve'
check reserve-definition      "$here/cs" def Reserve
check release-consumers       "$here/cs" uses '/api/v1/inventory/release'
check orders-reserved-v1      "$here/cs" uses 'orders.reserved.v1'
check orphaned-consumer       "$here/cs" uses 'orders.reserved.v2'
check reservation-event-shape "$here/cs" uses 'reservationId'
check reserve-flag            "$here/cs" uses 'inventory.reserve.enabled'

# Needs the dependency graph as well as the search, so it is run as a pair.
owner=$("$here/cs" provides com.acme:pricing-lib 2>/dev/null)
if [[ -n "$owner" ]]; then
  check discount-engine "$here/cs" def DiscountEngine "$owner"
else
  err "discount-engine (cs provides returned nothing)"; fail=$((fail + 1))
fi

# The LSP-backed query is slow and needs a per-language toolchain, so it is
# skipped rather than failed when Serena cannot run here.
if command -v uvx >/dev/null 2>&1; then
  info "  running the LSP query (slow, starts a language server)…"
  refs_out=$("$here/cs" refs IInventoryStore inventory-api-dotnet \
              src/Domain/IInventoryStore.cs 2>/dev/null \
              | sed 's|"\([a-z]*\)/|"inventory-api-dotnet/\1/|g')
  if printf '%s\n' "$refs_out" | "$here/score-seams" reserve-implementation - >/dev/null 2>&1; then
    ok "reserve-implementation"; pass=$((pass + 1))
  else
    err "reserve-implementation"; fail=$((fail + 1)); failed_ids+=("reserve-implementation")
  fi
else
  warn "reserve-implementation SKIPPED (uv not installed; cs refs unavailable)"
fi

# ---- engine parity ---------------------------------------------------------
# The answer must not depend on which text engine happens to be installed. This
# is not hypothetical: ripgrep defaults to skipping dotted paths and honouring
# .gitignore, while POSIX grep does neither, so before those flags were pinned a
# config key living in .github/ was found on a machine without ripgrep and
# missed on a machine with it. A search tool that answers differently per host
# is worse than a slow one, because nothing tells you which answer you got.
info ""
info "${C_BOLD}engine parity${C_OFF}"
if [[ -x "$(command -v rg 2>/dev/null || true)" ]]; then
  # A hidden path carrying a real seam, which is the case that used to diverge.
  probe_repo="$FLEET_ROOT/inventory-api-dotnet"
  mkdir -p "$probe_repo/.github/workflows"
  printf 'env:\n  RESERVE_FLAG: inventory.reserve.enabled\n' \
    > "$probe_repo/.github/workflows/parity-probe.yml"

  parity_bad=()
  for q in '/api/v1/inventory/reserve' 'orders.reserved.v1' 'reservationId' \
           'inventory.reserve.enabled' 'DiscountEngine'; do
    a=$(CS_TEXT_ENGINE=ripgrep "$here/cs" seam "$q" --quiet --all 2>/dev/null | sort)
    b=$(CS_TEXT_ENGINE=grep    "$here/cs" seam "$q" --quiet --all 2>/dev/null | sort)
    [[ "$a" == "$b" ]] || parity_bad+=("literal:$q")
  done
  # Regex is checked separately because the two backends do not share a flag
  # vocabulary: -E is --extended-regexp to grep and --encoding to ripgrep. That
  # made every `cs text` query fail with "unknown encoding" and report "nothing
  # found" on any machine that had ripgrep -- while the literal queries above,
  # which use -F, kept passing.
  for q in 'reserv[a-z]+Id' 'inventory\.reserve\.[a-z]+' 'class [A-Z][a-zA-Z]*'; do
    a=$(CS_TEXT_ENGINE=ripgrep "$here/cs" text "$q" --quiet --all 2>/dev/null | sort)
    b=$(CS_TEXT_ENGINE=grep    "$here/cs" text "$q" --quiet --all 2>/dev/null | sort)
    [[ "$a" == "$b" && -n "$a" ]] || parity_bad+=("regex:$q")
  done
  if [[ ${#parity_bad[@]} -eq 0 ]]; then
    ok "ripgrep and grep return identical results (literal and regex)"
    pass=$((pass + 1))
  else
    err "backends disagree on: ${parity_bad[*]}"; fail=$((fail + 1))
    failed_ids+=("engine-parity")
  fi

  hidden=$("$here/cs" seam 'inventory.reserve.enabled' --quiet --all 2>/dev/null | grep -c '\.github/')
  if [[ "$hidden" -ge 1 ]]; then
    ok "a seam inside a dotted path (.github/) is found"; pass=$((pass + 1))
  else
    err "the .github/ seam was missed — ripgrep is skipping hidden paths again"
    fail=$((fail + 1)); failed_ids+=("hidden-path-visibility")
  fi
  # Only the probe file. `rm -rf "$probe_repo/.github"` also deleted the
  # fixture's own ci.yml and CODEOWNERS, mutating the fleet for every check
  # after this one -- a test that quietly damages its own fixture.
  rm -f "$probe_repo/.github/workflows/parity-probe.yml"
else
  warn "engine parity SKIPPED (no ripgrep binary here; only the grep backend exists)"
fi

# ---- answer provenance -----------------------------------------------------
# Every answer must say what kind of evidence produced it, because that is what
# decides how much a negative result is worth. A subcommand that forgets to
# label itself silently downgrades the caller's ability to judge the result.
info ""
info "${C_BOLD}answer provenance${C_OFF}"
prov_missing=()
prov_check() {  # prov_check <expected-kind> <args...>
  local want="$1"; shift
  local line
  line=$("$here/cs" "$@" 2>&1 >/dev/null | grep '^answer:' | head -1)
  [[ "$line" == *"$want"* ]] || prov_missing+=("$* (wanted $want, got '${line:-nothing}')")
}
prov_check textual    text 'reservationId'
prov_check textual    seam 'reservationId'
prov_check heuristic  uses 'reservationId'
prov_check structural def Reserve
prov_check declared   provides com.acme:pricing-lib
prov_check declared   versions com.acme:pricing-lib
prov_check declared   owns inventory-api-dotnet
prov_check historical history 'reservationId'
command -v ast-grep >/dev/null 2>&1 && prov_check structural calls '$X.IsEnabled($K)'

if [[ ${#prov_missing[@]} -eq 0 ]]; then
  ok "every subcommand labels the kind of answer it gives"; pass=$((pass + 1))
else
  err "unlabelled answers:"; printf '    %s\n' "${prov_missing[@]}" >&2
  fail=$((fail + 1)); failed_ids+=("answer-provenance")
fi

# Each kind must have its blind spots written down; a label nobody can expand is
# decoration rather than information.
why_missing=()
for kind in resolved declared structural historical heuristic textual; do
  "$here/cs" why "$kind" >/dev/null 2>&1 || why_missing+=("$kind")
done
if [[ ${#why_missing[@]} -eq 0 ]]; then
  ok "every answer kind documents what it cannot see"; pass=$((pass + 1))
else
  err "no blind-spot text for: ${why_missing[*]}"; fail=$((fail + 1))
  failed_ids+=("answer-why")
fi

# The worst failure this tool can have is a timeout that looks like "no
# results", because the caller then concludes nothing uses the thing they were
# about to change. Engines run in subshells, so the timeout has to survive a
# process boundary to be reported at all -- which is why this is tested rather
# than assumed. The LSP path is used because it is reliably slower than 1s.
#
# The precondition is computed from a captured string rather than piped into
# `grep -q`. Under `set -o pipefail` that pipeline reports failure whenever grep
# exits on its first match before `cs engines` has finished writing -- SIGPIPE,
# not a missing timeout(1) -- so merely APPENDING a line to `cs engines` output
# turned this check into a silent SKIP. A check that downgrades itself when an
# unrelated thing changes is worse than no check, because the run still says
# "0 failed".
_engines_out=$("$here/cs" engines 2>/dev/null || true)
if command -v uvx >/dev/null 2>&1 && printf '%s\n' "$_engines_out" | grep -q '^timeout: *[0-9]'; then
  to=$(CS_TIMEOUT=1 "$here/cs" refs IInventoryStore inventory-api-dotnet \
        src/Domain/IInventoryStore.cs 2>&1 >/dev/null | grep -c 'PARTIAL')
  if [[ "$to" -ge 1 ]]; then
    ok "a timed-out engine reports PARTIAL, not empty"; pass=$((pass + 1))
  else
    err "a timeout was indistinguishable from 'no results'"; fail=$((fail + 1))
    failed_ids+=("timeout-visibility")
  fi
else
  warn "timeout visibility SKIPPED (needs uv and a timeout(1); brew install coreutils)"
fi

# A negative result must not be silent about being weak evidence, and a capped
# result must say it was capped rather than looking like the whole answer.
capped=$(CS_MAX_RESULTS=2 "$here/cs" seam 'reserve' 2>&1 >/dev/null | grep -c 'showing 2 of')
if [[ "$capped" -ge 1 ]]; then
  ok "a truncated result says so"; pass=$((pass + 1))
else
  err "truncation was silent"; fail=$((fail + 1)); failed_ids+=("truncation-notice")
fi

# ---- history ---------------------------------------------------------------
# `git log -S` reports commits where the number of occurrences changed, so a
# change made in place is invisible to it. That is the shape of a formatting or
# serializer change -- exactly the cross-repo trigger this fleet exists to make
# findable -- so an empty -S result has to escalate to -G rather than report
# "nothing happened".
info ""
info "${C_BOLD}history${C_OFF}"
hist_repo="$FLEET_ROOT/pricing-lib-java"
hist_file="$hist_repo/src/main/java/com/acme/pricing/DiscountEngine.java"
if [[ -f "$hist_file" ]]; then
  # Identity passed explicitly. A CI runner has no user.name/user.email, so
  # `git commit` failed with status 128, the two probe commits were never made,
  # and both checks below failed for a reason that had nothing to do with cs --
  # while `2>/dev/null` hid the only message that said so. build-fixtures got
  # this right from the start; this did not.
  hist_git() { git -C "$hist_repo" -c user.name=verify -c user.email=verify@local "$@"; }
  # Where to rewind to, recorded rather than assumed. `reset --hard HEAD~2`
  # unwinds two REAL fixture commits when the probe commits did not happen,
  # quietly corrupting the fleet for every check that follows.
  hist_base=$(git -C "$hist_repo" rev-parse HEAD 2>/dev/null || echo "")

  printf '\n// marker: PARITYSENTINEL added\n' >> "$hist_file"
  hist_git commit -aqm 'add sentinel' || warn "  probe commit failed; history checks below are not meaningful"
  perl -pi -e 's/PARITYSENTINEL added/PARITYSENTINEL reworded in place/' "$hist_file"
  hist_git commit -aqm 'reword sentinel in place' || true

  h=$("$here/cs" history 'PARITYSENTINEL' 2>&1)
  if printf '%s' "$h" | grep -q 'add sentinel'; then
    ok "history finds the commit that introduced a string"; pass=$((pass + 1))
  else
    err "history missed the introducing commit"; fail=$((fail + 1))
    failed_ids+=("history-introduce")
  fi

  h2=$("$here/cs" history 'PARITYSENTINEL reworded in place' 2>&1)
  if printf '%s' "$h2" | grep -q 'reword sentinel in place'; then
    ok "history escalates to -G for a change made in place"; pass=$((pass + 1))
  else
    err "a modification in place was reported as no history at all"
    fail=$((fail + 1)); failed_ids+=("history-escalation")
  fi

  if [[ -n "$hist_base" ]]; then
    git -C "$hist_repo" reset --hard -q "$hist_base" 2>/dev/null
  fi
else
  warn "history checks SKIPPED (fixture layout changed)"
fi

# ---- two-level view --------------------------------------------------------
# The opinionated setup is a fleet directory plus per-ticket workspaces, so the
# layering itself is tested: a ticket must see its own branch state AND the
# fleet repos it does not contain. Getting this wrong is dangerous rather than
# merely wrong -- searching only the ticket makes renaming a shared route look
# safe, because the caller lives in a repo the ticket does not include.
info ""
info "${C_BOLD}two-level view${C_OFF}"
tickets_tmp=$(mktemp -d)
# The workspace is built with plain git worktrees rather than by calling a
# ticket script, so this repo does not depend on whatever workflow tooling
# happens to sit alongside it.
mkdir -p "$tickets_tmp/VERIFY-1"
worktrees_ok=1
for r in inventory-api-dotnet checkout-service-kotlin; do
  git -C "$FLEET_ROOT/$r" worktree add --quiet \
      "$tickets_tmp/VERIFY-1/$r" -b verify/layering >/dev/null 2>&1 || worktrees_ok=0
done

if [[ $worktrees_ok -eq 1 ]]; then
  wt="$tickets_tmp/VERIFY-1/inventory-api-dotnet"
  perl -pi -e 's/\[HttpPost\("reserve"\)\]/[HttpPost("reserve-probe")]/' \
      "$wt/src/Controllers/ReservationController.cs"

  layered=$(cd "$tickets_tmp/VERIFY-1" && TICKETS_ROOT="$tickets_tmp" \
            "$here/cs" uses '/api/v1/inventory/reserve' 2>/dev/null)
  if printf '%s' "$layered" | grep -q 'web-monorepo-node'; then
    ok "ticket sees a caller in a repo it does not contain"; pass=$((pass + 1))
  else
    err "ticket did NOT see the out-of-ticket caller"; fail=$((fail + 1))
    failed_ids+=("layered-out-of-ticket-caller")
  fi

  branch_state=$(cd "$tickets_tmp/VERIFY-1" && TICKETS_ROOT="$tickets_tmp" \
                 "$here/cs" uses 'reserve-probe' 2>/dev/null)
  if printf '%s' "$branch_state" | grep -q 'inventory-api-dotnet'; then
    ok "ticket working state shadows the fleet copy"; pass=$((pass + 1))
  else
    err "ticket edits were NOT visible"; fail=$((fail + 1))
    failed_ids+=("layered-branch-precedence")
  fi

  fleet_state=$(cd "$tickets_tmp/VERIFY-1" && TICKETS_ROOT="$tickets_tmp" \
                "$here/cs" --fleet uses 'reserve-probe' 2>/dev/null)
  if [[ -z "$fleet_state" ]]; then
    ok "--fleet excludes ticket edits"; pass=$((pass + 1))
  else
    err "--fleet leaked ticket state"; fail=$((fail + 1))
    failed_ids+=("layered-fleet-isolation")
  fi

  for r in inventory-api-dotnet checkout-service-kotlin; do
    git -C "$FLEET_ROOT/$r" worktree remove --force \
        "$tickets_tmp/VERIFY-1/$r" >/dev/null 2>&1 || true
    git -C "$FLEET_ROOT/$r" branch -D verify/layering >/dev/null 2>&1 || true
  done
else
  warn "could not create worktrees; layering untested"
fi
rm -rf "$tickets_tmp"

# ---- declared answers ------------------------------------------------------
# `cs owns` and `cs versions` read manifests and CODEOWNERS rather than code, so
# nothing in the scored queries touches them. Both answer questions that follow
# directly from a search result -- who do I talk to, and is the fleet agreed on
# this version -- and both are the kind of answer most likely to be repeated to
# a person as fact, which is the argument for testing them precisely.
info ""
info "${C_BOLD}declared answers${C_OFF}"

# CODEOWNERS is last-match-wins, and getting that backwards silently names the
# wrong team: the catch-all `*` at the top would win over every specific rule.
owns_out=$("$here/cs" owns inventory-api-dotnet/src/Infrastructure/SqlInventoryStore.cs 2>/dev/null)
if printf '%s' "$owns_out" | grep -q 'storage-team'; then
  ok "cs owns applies the LAST matching CODEOWNERS rule"; pass=$((pass + 1))
elif printf '%s' "$owns_out" | grep -q 'inventory-team'; then
  err "cs owns returned the catch-all rule — first match won, not last"
  fail=$((fail + 1)); failed_ids+=("owns-last-match")
else
  err "cs owns did not resolve an owner at all"; fail=$((fail + 1))
  failed_ids+=("owns-last-match")
fi

# An unowned repo is the finding, not an error. It must not be silently absent
# from the audit, and it must not be reported on stdout as though it were an
# answer -- "who owns pricing-lib-java" has no answer, and saying so is the point.
audit_out=$("$here/cs" owns 2>/dev/null)
audit_err=$("$here/cs" owns 2>&1 >/dev/null)
if printf '%s' "$audit_err" | grep -q 'pricing-lib-java' \
   && ! printf '%s' "$audit_out" | grep -q 'pricing-lib-java'; then
  ok "cs owns reports a repo with no CODEOWNERS as a gap, not a result"
  pass=$((pass + 1))
else
  err "cs owns mishandled the repo that declares no ownership"
  fail=$((fail + 1)); failed_ids+=("owns-gap")
fi

# The whole value of a drift report is that its findings are worth acting on, so
# a false positive is worse than a miss. `==2.4.0` and `2.4.0` are the same
# version in two ecosystems' dialects and must not be called drift.
ver_same=$("$here/cs" versions acme-schemas 2>/dev/null)
pkg_json="$FLEET_ROOT/web-monorepo-node/package.json"
perl -pi -e 's/"acme-schemas": "2\.4\.0"/"acme-schemas": "2.5.1"/' "$pkg_json" 2>/dev/null
ver_drift=$("$here/cs" versions acme-schemas 2>/dev/null)
perl -pi -e 's/"acme-schemas": "2\.5\.1"/"acme-schemas": "2.4.0"/' "$pkg_json" 2>/dev/null
if printf '%s' "$ver_same" | grep -q 'AGREED' && printf '%s' "$ver_drift" | grep -q 'DRIFT'; then
  ok "cs versions tells a dialect difference from a real version drift"
  pass=$((pass + 1))
elif printf '%s' "$ver_same" | grep -q 'DRIFT'; then
  err "cs versions called '==2.4.0' vs '2.4.0' a drift — false positive"
  fail=$((fail + 1)); failed_ids+=("versions-false-drift")
else
  err "cs versions missed a real version drift"; fail=$((fail + 1))
  failed_ids+=("versions-drift")
fi

# ---- refusals --------------------------------------------------------------
# Everything above tests that cs ANSWERS. This section tests that it REFUSES.
#
# The two are not the same property, and only the second one protects the claim
# this tool actually makes. A broken engine, a missing interpreter, a typo'd
# workspace and two questions asked at once all used to produce the same thing:
# a well-formatted, correctly-labelled, entirely empty answer. "No code uses
# this" is what makes deleting a live endpoint look safe, so a zero-hit result
# that is really a malfunction is the one bug class worth a suite of its own.
#
# Each check below reproduces a real defect found by probing rather than by
# reading -- which is the argument for the section: none of them failed a single
# scored query.
info ""
info "${C_BOLD}refusals — a malfunction must not look like a negative result${C_OFF}"

# Asserts the REFUSAL exit code (1), not merely "non-zero". A zero-hit answer
# is also non-zero -- it is 2 -- and before the codes were split, every check in
# this section passed just as happily for a query that ran and found nothing as
# for one that refused to run. The message text was the only thing separating
# them, which is exactly the weakness the codes exist to fix, so testing on the
# text alone left the whole section unable to detect the bug it is named after.
refuses() {  # refuses <name> <expected-message-fragment> <command...>
  local name="$1" want="$2"; shift 2
  local out rc
  out=$("$@" 2>&1); rc=$?
  if [[ $rc -eq 1 ]] && printf '%s' "$out" | grep -qi -- "$want"; then
    ok "$name"; pass=$((pass + 1))
  elif [[ $rc -eq 0 ]]; then
    err "$name — exited 0 and answered instead of refusing"; fail=$((fail + 1))
    failed_ids+=("$name")
  elif [[ $rc -eq 2 ]]; then
    err "$name — exited 2 (a query that ran and found nothing), not 1 (a refusal)"
    fail=$((fail + 1)); failed_ids+=("$name")
  else
    err "$name — exited $rc, but not with the reason a caller can act on"; fail=$((fail + 1))
    failed_ids+=("$name")
  fi
}

# The other side of the same contract: a query that ran honestly and found
# nothing must be distinguishable from one that never ran.
finds_nothing() {  # finds_nothing <name> <command...>
  local name="$1"; shift
  local rc
  "$@" >/dev/null 2>&1; rc=$?
  case "$rc" in
    2) ok "$name"; pass=$((pass + 1)) ;;
    0) err "$name — exited 0; it found something, so the probe is wrong"
       fail=$((fail + 1)); failed_ids+=("$name") ;;
    1) err "$name — exited 1 (a refusal), so a caller cannot tell 'no hits' from 'did not run'"
       fail=$((fail + 1)); failed_ids+=("$name") ;;
    *) err "$name — exited $rc, which is neither code"
       fail=$((fail + 1)); failed_ids+=("$name") ;;
  esac
}

# python3 is a hard dependency of `uses`, `provides`, `deps` and `publishes`,
# not an optional engine. Without it the pipe produced nothing and every one of
# them reported a confident zero-hit answer -- `uses` still claiming "prose
# filtered", a filter that had not run.
nopy=$(mktemp -d); printf '#!/bin/sh\nexit 127\n' > "$nopy/python3"; chmod +x "$nopy/python3"
refuses "cs uses without python3 refuses"     "python3" \
  env PATH="$nopy:$PATH" "$here/cs" uses '/api/v1/inventory/reserve'
refuses "cs provides without python3 refuses" "python3" \
  env PATH="$nopy:$PATH" "$here/cs" provides 'com.acme:pricing-lib'
rm -rf "$nopy"

# Asking for a named workspace and being handed the fleet is the inverse of the
# mistake the layering exists to prevent: the caller wanted their branch state
# and silently got main, with no `searching:` line to reveal the substitution.
refuses "--ticket with an unknown id refuses" "no such workspace" \
  env TICKETS_ROOT="$(mktemp -d)" "$here/cs" --ticket=NO-SUCH-TICKET uses 'orders.reserved.v1'
# common.sh defaults TICKETS_ROOT, so an unset one resolves against ~/tickets
# rather than failing outright -- the refusal must still say WHERE it looked, or
# a wrong TICKETS_ROOT and a typo'd id are indistinguishable from the message.
refuses "--ticket refusal names the root it searched" "TICKETS_ROOT is" \
  env -u TICKETS_ROOT "$here/cs" --ticket=NO-SUCH-TICKET uses 'orders.reserved.v1'

# An empty fleet root answers "nothing found" for every question ever asked.
refuses "an empty fleet root refuses" "no repositories" \
  env FLEET_ROOT="$(mktemp -d)" "$here/cs" uses 'orders.reserved.v1'

# ---- the refusal must be DETECTABLE, not merely explained -------------------
# The distinction between "this search did not happen" and "this search happened
# and the answer is no" is the tool's central promise, and it lived only in
# prose on stderr. `if cs uses "$route"; then echo in use; else echo unused; fi`
# -- the obvious thing for a caller to write -- reported "unused" for a typo'd
# FLEET_ROOT, which is the exact false negative the whole design is organised
# against. So the two outcomes get two codes, and both sides are asserted here:
# every refuses() call above now pins exit 1, and these pin exit 2.
refuses "a nonexistent fleet root refuses (exit 1)" "does not exist" \
  env FLEET_ROOT="/nonexistent/$$/fleet" "$here/cs" uses 'orders.reserved.v1'
# Built per run rather than written as a literal: a literal probe string is
# itself a string in this repo, so pointing FLEET_ROOT at a fleet that happens
# to contain this checkout would find it and invert every check below.
absent="cs-absent-probe-$$-${RANDOM:-0}"
finds_nothing "a genuine zero-hit cs uses exits 2"     "$here/cs" uses "$absent"
finds_nothing "a genuine zero-hit cs seam exits 2"     "$here/cs" seam "$absent"
finds_nothing "a genuine zero-hit cs text exits 2"     "$here/cs" text "$absent"
finds_nothing "a genuine zero-hit cs def exits 2"      "$here/cs" def "CsAbsentSymbol$$"
finds_nothing "a genuine zero-hit cs history exits 2"  "$here/cs" history "$absent"
finds_nothing "a genuine zero-hit cs provides exits 2" "$here/cs" provides "com.acme:$absent"

# The codes have to be written down where a caller looks, or they are a private
# convention. Both `cs --help` (the file header) and `cs why` must state them.
#
# Captured rather than piped into `grep -q`, for the third time in this file:
# under `set -o pipefail` the producer is killed by SIGPIPE the moment grep
# matches, so the pipeline reports failure on success and the check inverts.
codes_doc=0
_help_out=$("$here/cs" --help 2>&1 || true)
_why_out=$("$here/cs" why 2>&1 || true)
printf '%s' "$_help_out" | grep -qi 'exit codes' && codes_doc=$((codes_doc + 1))
printf '%s' "$_why_out"  | grep -qi 'exit codes' && codes_doc=$((codes_doc + 1))
if [[ $codes_doc -eq 2 ]]; then
  ok "cs --help and cs why both document the exit codes"; pass=$((pass + 1))
else
  err "the exit codes are undocumented in cs --help and/or cs why"
  fail=$((fail + 1)); failed_ids+=("exit-codes-documented")
fi

# ---- the analyser, not just the driver -------------------------------------
# `cs refs` / `cs impls` preflighted uvx, python3 and the repo directory -- the
# DRIVER and its plumbing, none of which say whether the language can be
# analysed. On a machine with uv but no .NET SDK all three passed, the language
# server loaded nothing, and the empty result was printed as
#
#     answer: resolved via serena (LSP) · 0 hit(s)
#
# the STRONGEST negative in the taxonomy, asserted about a repo with two known
# references. That is this tool's own worst failure mode, reproduced inside it.
#
# uvx is shimmed present and the toolchains shimmed unrunnable, so the check
# exercises the toolchain gate on every machine rather than only on one that
# happens to be missing an SDK.
notc=$(mktemp -d)
printf '#!/bin/sh\nexit 0\n'   > "$notc/uvx"     # driver present…
for b in dotnet java node; do printf '#!/bin/sh\nexit 127\n' > "$notc/$b"; done  # …analyser not
chmod +x "$notc"/*
refuses "cs refs without the language toolchain refuses" "dotnet" \
  env PATH="$notc:$PATH" "$here/cs" refs IInventoryStore inventory-api-dotnet \
      src/Domain/IInventoryStore.cs
refuses "cs impls without the language toolchain refuses" "dotnet" \
  env PATH="$notc:$PATH" "$here/cs" impls IInventoryStore inventory-api-dotnet

# Refusing is half of it. The other half is that the `resolved` label must not
# reach the caller on a run that could not have produced one -- it was assigned
# before the call and survived every outcome.
notc_out=$(env PATH="$notc:$PATH" "$here/cs" refs IInventoryStore \
           inventory-api-dotnet src/Domain/IInventoryStore.cs 2>&1)
if printf '%s' "$notc_out" | grep -q 'answer:.*resolved'; then
  err "cs refs printed a 'resolved' answer for a language it could not analyse"
  fail=$((fail + 1)); failed_ids+=("resolved-label-on-unanalysed")
else
  ok "no 'resolved' label is printed when the toolchain is missing"; pass=$((pass + 1))
fi
rm -rf "$notc"

# stdout is the scoreable result stream and nothing else. A zero-hit `cs uses`
# still prints the comment-only mentions it excluded, which is useful context
# and NOT a result -- on stdout those lines were indistinguishable from hits, so
# a docstring decoy could be scored against the answer that correctly excluded
# it. Every diagnostic belongs on stderr; this asserts the separation holds.
zero_stdout=$("$here/cs" uses '/api/v1/inventory/release' 2>/dev/null)
if [[ -z "$zero_stdout" ]]; then
  ok "a zero-hit answer writes nothing to stdout"; pass=$((pass + 1))
else
  err "a zero-hit answer leaked $(printf '%s\n' "$zero_stdout" | grep -c '') line(s) onto stdout"
  fail=$((fail + 1)); failed_ids+=("stdout-purity")
fi

# CS_EXCLUDE_REMOVE can legitimately empty the exclusion list, and stock macOS
# ships bash 3.2, where expanding an EMPTY array under `set -u` is a fatal
# "unbound variable". The failure was not a crash: cs printed the error to
# stderr, skipped the search, and reported "no repo mentions '...'" -- a
# manufactured negative produced by a configuration the flag exists to allow.
# Both backends are checked, since each builds its own flag array.
excl_all=$("$here/cs" engines 2>/dev/null | grep '^skipping' | sed 's/^skipping: *//')
excl_bad=()
for eng in ripgrep grep; do
  n=$(CS_EXCLUDE_REMOVE="$excl_all" CS_TEXT_ENGINE="$eng" \
      "$here/cs" seam 'orders.reserved.v1' --quiet 2>/dev/null | grep -c 'EventPublisher')
  [[ "$n" -ge 1 ]] || excl_bad+=("$eng")
done
if [[ ${#excl_bad[@]} -eq 0 ]]; then
  ok "an emptied exclusion list still searches (both backends)"; pass=$((pass + 1))
else
  err "CS_EXCLUDE_REMOVE emptying the list broke: ${excl_bad[*]}"
  fail=$((fail + 1)); failed_ids+=("empty-exclusion-list")
fi

# `cs def` reuses its symbol index for CS_TAGS_TTL seconds, so the second call
# takes a completely different code path from the first -- and that path read
# the file's mtime with `stat -f %m`, which means "format" on BSD and
# "filesystem" on GNU. On Linux it therefore printed a filesystem dump into an
# arithmetic expression and killed the command, so `cs def` worked once and then
# failed for the next 60 seconds. Every check that ran a second `cs def` failed
# with it, and none of them said why.
#
# Calling it twice is the whole test. Nothing else exercised the cache hit,
# which is why a bug affecting every Linux user survived a green macOS run.
def_first=$("$here/cs" def Reserve --refresh 2>&1)
def_cached=$("$here/cs" def Reserve 2>&1)
if printf '%s' "$def_cached" | grep -q 'ReservationController' \
   && printf '%s' "$def_cached" | grep -q 'cached'; then
  ok "a second 'cs def' answers from the cache"; pass=$((pass + 1))
elif printf '%s' "$def_first" | grep -q 'ReservationController'; then
  err "'cs def' answered once, then failed on the cache-hit path"
  fail=$((fail + 1)); failed_ids+=("def-cache-hit")
else
  err "'cs def' did not answer at all"; fail=$((fail + 1)); failed_ids+=("def-cache-hit")
fi

# Agents issue tool calls in parallel. `cs def` cached its symbol index at a
# path derived from the fleet, so concurrent runs raced on the same file and
# roughly half returned nothing -- each labelled a normal structural answer.
conc_tmp=$(mktemp -d); conc_n=6
for i in $(seq 1 $conc_n); do
  ( "$here/cs" def Reserve 2>/dev/null > "$conc_tmp/$i" ) &
done
wait
conc_bad=0
for i in $(seq 1 $conc_n); do
  grep -q 'ReservationController' "$conc_tmp/$i" 2>/dev/null || conc_bad=$((conc_bad + 1))
done
if [[ $conc_bad -eq 0 ]]; then
  ok "$conc_n concurrent 'cs def' runs all agree"; pass=$((pass + 1))
else
  err "$conc_bad of $conc_n concurrent 'cs def' runs returned nothing (index race)"
  fail=$((fail + 1)); failed_ids+=("concurrent-def")
fi
rm -rf "$conc_tmp"

# The prose filter covers a fixed set of languages. One it does not know is
# passed through unfiltered, which is defensible -- claiming "prose filtered"
# over it is not. The claim has to name the exception.
unsup_repo="$FLEET_ROOT/checkout-service-kotlin"
if [[ -d "$unsup_repo" ]]; then
  mkdir -p "$unsup_repo/unfiltered"
  printf ';; only a comment, in a language the filter cannot parse: cs-unsupported-probe\n' \
    > "$unsup_repo/unfiltered/probe.unknownlang"
  unsup_out=$("$here/cs" uses 'cs-unsupported-probe' 2>&1)
  if printf '%s' "$unsup_out" | grep -q 'NOT filtered'; then
    ok "an unfilterable language is named, not silently claimed as filtered"
    pass=$((pass + 1))
  else
    err "a hit in an unknown language was reported as 'prose filtered'"
    fail=$((fail + 1)); failed_ids+=("unsupported-language-claim")
  fi
  rm -rf "$unsup_repo/unfiltered"
fi

# Per-language prose filtering. The filter recognises comments by extension, so
# its coverage is a table and the only way to know the table is right is to try
# every entry. The five fixture repos cannot do this: they are all written in
# languages the filter supported from the start, which is precisely why C++
# comments were being counted as call sites and nothing noticed.
#
# Each probe file carries a -CODE token in executable code and a -PROSE token in
# comments only. Both halves are asserted: demanding only that -PROSE is absent
# would pass just as happily if `cs uses` returned nothing at all.
probe_src="$repo_root_dir/fixtures/prose-probes"
if [[ -d "$probe_src" ]]; then
  probe_repo="$FLEET_ROOT/prose-probe-repo"
  mkdir -p "$probe_repo"
  cp "$probe_src"/probe.* "$probe_src"/Dockerfile "$probe_repo/" 2>/dev/null || true
  git -C "$probe_repo" init -q 2>/dev/null || true

  langs_ok=(); langs_prose=(); langs_code=()
  for f in "$probe_repo"/*; do
    [[ -f "$f" ]] || continue
    b=$(basename "$f")
    [[ "$b" == "README.md" ]] && continue
    # The token names are carried in the files, so adding a language needs no
    # change here -- drop in probe.<ext> and it is covered.
    tok=$(grep -o 'cs-probe-[a-z]*-CODE' "$f" | head -1)
    [[ -n "$tok" ]] || continue
    lang="${tok#cs-probe-}"; lang="${lang%-CODE}"
    n_code=$("$here/cs" uses "cs-probe-$lang-CODE" 2>/dev/null | grep -c "$b")
    n_prose=$("$here/cs" uses "cs-probe-$lang-PROSE" 2>/dev/null | grep -c "$b")
    if [[ "$n_code" -ge 1 && "$n_prose" -eq 0 ]]; then langs_ok+=("$lang")
    elif [[ "$n_code" -eq 0 ]]; then langs_code+=("$lang")
    else langs_prose+=("$lang"); fi
  done

  if [[ ${#langs_code[@]} -eq 0 && ${#langs_prose[@]} -eq 0 ]]; then
    ok "prose filtering holds for ${#langs_ok[@]} languages: ${langs_ok[*]:-}"
    pass=$((pass + 1))
  else
    [[ ${#langs_prose[@]} -gt 0 ]] && err "comments counted as code uses in: ${langs_prose[*]}"
    [[ ${#langs_code[@]} -gt 0 ]] && err "real code uses were dropped in: ${langs_code[*]}"
    fail=$((fail + 1)); failed_ids+=("prose-filter-languages")
  fi
  rm -rf "$probe_repo"
fi

info ""
info "${C_BOLD}$pass passed, $fail failed${C_OFF}"
for f in "${failed_ids[@]:-}"; do
  [[ -n "$f" ]] && info "  re-run one: $here/score-seams $f -"
done

if [[ $owned_fleet -eq 1 && $keep -eq 0 ]]; then
  rm -rf "$(dirname "$FLEET_ROOT")"
else
  [[ $owned_fleet -eq 1 ]] && info "fleet kept at $FLEET_ROOT"
fi

[[ $fail -eq 0 ]]
