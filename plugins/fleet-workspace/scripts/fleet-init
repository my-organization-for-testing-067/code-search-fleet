#!/usr/bin/env bash
# First-time setup for the fleet: write the config, clone the repos, and print
# the daily refresh schedule. Everything else in this plugin assumes the layout
# this creates.
#
# Nothing here is destructive. An existing config is not overwritten without
# --force, and a repo already in the fleet is left alone rather than re-cloned,
# so re-running is how you ADD repos later rather than a thing to avoid.
#
# Usage:
#   fleet-init --status                          what is configured and cloned
#   fleet-init --config [--fleet-root DIR] [--tickets-root DIR] [--branch-prefix P]
#   fleet-init --clone <owner/repo|url> [...]    clone into the fleet
#   fleet-init --clone-from <file>               one repo per line (# comments ok)
#   fleet-init --cron                            print the daily refresh line
#
#   --force   overwrite an existing config file
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

# Written to the neutral path. The legacy ~/.config/ai-toolbox/fleet.env is
# still read by common.sh if it exists, so an earlier setup keeps working.
CONFIG_DIR="${HOME}/.config/repo-fleet"
CONFIG_FILE="$CONFIG_DIR/fleet.env"

do_config=0; do_clone=0; do_cron=0; do_status=0; force=0
clone_args=(); clone_file=""
new_fleet_root=""; new_tickets_root=""; new_prefix=""

[[ $# -ge 1 ]] || { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --status) do_status=1; shift ;;
    --config) do_config=1; shift ;;
    --cron) do_cron=1; shift ;;
    --force) force=1; shift ;;
    --fleet-root) new_fleet_root="${2:?}"; shift 2 ;;
    --tickets-root) new_tickets_root="${2:?}"; shift 2 ;;
    --branch-prefix) new_prefix="${2:?}"; shift 2 ;;
    --clone-from) clone_file="${2:?}"; do_clone=1; shift 2 ;;
    --clone) do_clone=1; shift
             while [[ $# -gt 0 && "$1" != --* ]]; do clone_args+=("$1"); shift; done ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

# ---- status ----------------------------------------------------------------
if [[ $do_status -eq 1 ]]; then
  info "${C_BOLD}config${C_OFF}"
  local_found=0
  for f in "$CONFIG_FILE" "${HOME}/.config/ai-toolbox/fleet.env"; do
    [[ -f "$f" ]] && { info "  $f"; local_found=1; }
  done
  [[ $local_found -eq 0 ]] && warn "  none — run: fleet-init --config"
  printf '  %-14s %s\n' "FLEET_ROOT" "$FLEET_ROOT" >&2
  printf '  %-14s %s\n' "TICKETS_ROOT" "$TICKETS_ROOT" >&2
  printf '  %-14s %s\n' "BRANCH_PREFIX" "$BRANCH_PREFIX" >&2
  info ""
  info "${C_BOLD}fleet${C_OFF}  $FLEET_ROOT"
  if [[ -d "$FLEET_ROOT" ]]; then
    n=0
    while IFS= read -r r; do
      [[ -n "$r" ]] || continue
      n=$((n + 1))
      b=$(default_branch "$FLEET_ROOT/$r" 2>/dev/null || echo '?')
      printf '  %-34s %s\n' "$r" "$b" >&2
    done < <(fleet_repos 2>/dev/null)
    [[ $n -eq 0 ]] && warn "  empty — run: fleet-init --clone <owner/repo> ..."
  else
    warn "  does not exist yet"
  fi
  info ""
  info "${C_BOLD}tickets${C_OFF}  $TICKETS_ROOT"
  if [[ -d "$TICKETS_ROOT" ]]; then
    for d in "$TICKETS_ROOT"/*/; do
      [[ -d "$d" ]] || continue
      printf '  %-34s %s repo(s)\n' "$(basename "$d")" \
        "$(find "$d" -maxdepth 1 -mindepth 1 -type d | grep -c '')" >&2
    done
  else
    info "  none yet"
  fi
  exit 0
fi

# ---- config ----------------------------------------------------------------
if [[ $do_config -eq 1 ]]; then
  fr="${new_fleet_root:-$FLEET_ROOT}"
  tr="${new_tickets_root:-$TICKETS_ROOT}"
  bp="${new_prefix:-$BRANCH_PREFIX}"
  # Expand ~ so the written file holds a real path; the scripts source it
  # non-interactively and would not expand it themselves.
  fr="${fr/#\~/$HOME}"; tr="${tr/#\~/$HOME}"

  [[ "$fr" == "$tr" ]] && die "fleet root and tickets root must differ (both: $fr)"
  if [[ -f "$CONFIG_FILE" && $force -eq 0 ]]; then
    err "config already exists: $CONFIG_FILE"
    info "current contents:"; sed 's/^/  /' "$CONFIG_FILE" >&2
    die "pass --force to overwrite"
  fi

  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" <<EOF
# Fleet layout. Read by every script in the fleet-workspace plugin.
# Environment variables still win over this file.
export FLEET_ROOT="$fr"
export TICKETS_ROOT="$tr"
export BRANCH_PREFIX="$bp"
EOF
  ok "wrote $CONFIG_FILE"
  sed 's/^/  /' "$CONFIG_FILE" >&2
  mkdir -p "$fr" "$tr"
  info ""
  info "Created $fr and $tr."
  info "Next: fleet-init --clone <owner/repo> ..."
fi

# ---- clone -----------------------------------------------------------------
if [[ $do_clone -eq 1 ]]; then
  if [[ -n "$clone_file" ]]; then
    [[ -f "$clone_file" ]] || die "no such file: $clone_file"
    while IFS= read -r line; do
      line="${line%%#*}"; line="$(printf '%s' "$line" | tr -d '[:space:]')"
      [[ -n "$line" ]] && clone_args+=("$line")
    done < "$clone_file"
  fi
  [[ ${#clone_args[@]} -gt 0 ]] || die "nothing to clone"
  mkdir -p "$FLEET_ROOT"
  info "${C_BOLD}cloning into${C_OFF} $FLEET_ROOT"

  cloned=0; present=0; failed=()
  for spec in "${clone_args[@]}"; do
    name="${spec##*/}"; name="${name%.git}"
    dest="$FLEET_ROOT/$name"
    if [[ -d "$dest/.git" ]]; then
      info "  $name — already in the fleet"
      present=$((present + 1))
      continue
    fi
    # gh handles private repos and SSH/HTTPS choice; git is the fallback for a
    # full URL when gh is not installed.
    if [[ "$spec" != *://* && "$spec" != *@*:* ]] && command -v gh >/dev/null 2>&1; then
      gh repo clone "$spec" "$dest" -- --quiet >/dev/null 2>&1 || failed+=("$spec")
    else
      git clone --quiet "$spec" "$dest" >/dev/null 2>&1 || failed+=("$spec")
    fi
    if [[ -d "$dest/.git" ]]; then
      # Record origin/HEAD so default_branch() never has to guess.
      git -C "$dest" remote set-head origin --auto >/dev/null 2>&1 || true
      ok "  $name — $(default_branch "$dest" 2>/dev/null || echo '?')"
      cloned=$((cloned + 1))
    fi
  done
  info ""
  info "${C_BOLD}$cloned cloned, $present already present, ${#failed[@]} failed${C_OFF}"
  for f in "${failed[@]:-}"; do [[ -n "$f" ]] && err "$f"; done
  [[ ${#failed[@]} -eq 0 ]] || exit 1
fi

# ---- cron ------------------------------------------------------------------
if [[ $do_cron -eq 1 ]]; then
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/refresh-fleet"
  info "${C_BOLD}Daily refresh — add to crontab -e:${C_OFF}"
  info ""
  printf '  0 7 * * *  %s --quiet\n' "$self" >&2
  info ""
  info "--quiet prints only problems, which is what you want from cron."
  info "The fleet is reset hard, which is safe because feature work lives in"
  info "ticket worktrees, never in the fleet checkout itself."
fi
