#!/usr/bin/env bash
# Update every fleet repo to its origin default branch.
#
# Safe because the fleet is read-mostly (docs/repo-fleet.md, assumption 1):
# feature work happens in ticket worktrees, never in the fleet checkout itself.
# A repo with local modifications violates that assumption, so it is reported
# and skipped rather than reset -- pass --force to reset it anyway.
#
# Resetting a fleet checkout does not disturb worktrees on other branches.
#
# Usage: refresh-fleet [--force] [--quiet] [repo...]
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

force=0
quiet=0
repos=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) force=1 ;;
    --quiet) quiet=1 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) repos+=("$1") ;;
  esac
  shift
done

if [[ ${#repos[@]} -eq 0 ]]; then
  while IFS= read -r r; do repos+=("$r"); done < <(fleet_repos)
fi
[[ ${#repos[@]} -gt 0 ]] || die "no repos found under $FLEET_ROOT"

updated=() skipped=() failed=()

for repo in "${repos[@]}"; do
  dir="$FLEET_ROOT/$repo"
  if [[ ! -d "$dir/.git" ]]; then
    failed+=("$repo: not a git repo")
    continue
  fi

  if ! git -C "$dir" fetch --prune --quiet origin 2>/dev/null; then
    failed+=("$repo: fetch failed")
    continue
  fi

  if ! branch=$(default_branch "$dir"); then
    failed+=("$repo: no origin default branch (main/master) found")
    continue
  fi

  # Dirty checkout means someone worked directly in the fleet -- surface it.
  if [[ -n "$(git -C "$dir" status --porcelain)" && $force -eq 0 ]]; then
    skipped+=("$repo: local changes present (use --force to discard)")
    continue
  fi

  before=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo none)
  if ! git -C "$dir" checkout --quiet "$branch" 2>/dev/null; then
    # Branch may be checked out in a worktree; reset the remote-tracking state anyway.
    failed+=("$repo: cannot check out $branch (checked out in a worktree?)")
    continue
  fi
  if ! git -C "$dir" reset --hard --quiet "origin/$branch"; then
    failed+=("$repo: reset to origin/$branch failed")
    continue
  fi
  after=$(git -C "$dir" rev-parse --short HEAD)

  if [[ "$before" == "$after" ]]; then
    [[ $quiet -eq 1 ]] || info "  $repo — already current ($after)"
  else
    updated+=("$repo")
    [[ $quiet -eq 1 ]] || ok "$repo — $before → $after"
  fi
done

# No re-index step, deliberately: search over the fleet is index-free, so a
# reset repo is correctly searchable the moment the reset finishes.

if [[ $quiet -eq 0 || ${#skipped[@]} -gt 0 || ${#failed[@]} -gt 0 ]]; then
  info ""
  info "${C_BOLD}${#updated[@]} updated, ${#skipped[@]} skipped, ${#failed[@]} failed${C_OFF}"
fi
for s in "${skipped[@]:-}"; do [[ -n "$s" ]] && warn "$s"; done
for f in "${failed[@]:-}"; do [[ -n "$f" ]] && err  "$f"; done

[[ ${#failed[@]} -eq 0 ]]
